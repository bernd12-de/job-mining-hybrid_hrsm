import de.layher.jobmining.kotlinapi.domain.EscoSkill\
import de.layher.jobmining.kotlinapi.infrastructure.io.IOService\
import org.springframework.stereotype.Repository\
import org.springframework.beans.factory.annotation.Value\
import java.util.concurrent.ConcurrentHashMap\
import jakarta.annotation.PostConstruct\
import java.io.File\
\
@Repository\
class EscoDataRepository(\
    private val ioService: IOService,\
    @Value("\\$\{app.esco.data-path:./data/esco\}") private val escoFolderPath: String\
) \{\
    // SSoT: Label -> Skill-Objekt\
    private val skillMap = ConcurrentHashMap<String, EscoSkill>()\
\
    @PostConstruct\
    fun init() \{\
        val totalLoaded = loadAllFromFolder()\
        // Wissenschaftlicher Integrit\'e4tscheck (Ebene 7)\
        if (totalLoaded < 10000) \{\
            throw IllegalStateException("INTEGRITY ERROR: Nur $totalLoaded ESCO-Labels gefunden! Checke Pfad: $escoFolderPath")\
        \}\
        println("
\f8 \uc0\u9989 
\f2  ESCO-Wissensbasis stabil: $totalLoaded Labels (inkl. Synonyme) geladen.")\
    \}\
\
    fun loadAllFromFolder(): Int \{\
        var totalLoadedCount = 0\
        val folder = File(escoFolderPath)\
\
        if (!folder.exists() || !folder.isDirectory) \{\
            println("
\f8 \uc0\u10060 
\f2  Fehler: Verzeichnis nicht gefunden: $\{folder.absolutePath\}")\
            return 0\
        \}\
\
        folder.listFiles \{ f -> f.extension == "csv" \}?.forEach \{ file ->\
            try \{\
                file.bufferedReader().useLines \{ lines ->\
                    // \'dcberspringe Header\
                    lines.drop(1).forEach \{ lineStr ->\
                        val parts = lineStr.split(",") // Vereinfacht f\'fcr Standard-CSV\
                        if (parts.size > 5) \{\
                            val uri = parts[1]\
                            val prefLabel = parts[4].trim()\
                            val altLabelsRaw = parts[5].trim().replace("\\"", "")\
\
                            // Erzeuge Skill-Objekt\
                            val skill = EscoSkill(\
                                uri = uri,\
                                preferredLabel = prefLabel,\
                                altLabels = if (altLabelsRaw.isNotEmpty()) altLabelsRaw.split("|") else emptyList()\
                            )\
\
                            // FIX: Registriere Preferred Label UND alle Synonyme einzeln\
                            val allTerms = mutableListOf(prefLabel)\
                            if (altLabelsRaw.isNotEmpty()) \{\
                                allTerms.addAll(altLabelsRaw.split("|").map \{ it.trim() \})\
                            \}\
\
                            allTerms.forEach \{ term ->\
                                val key = term.lowercase()\
                                if (key.isNotEmpty() && !skillMap.containsKey(key)) \{\
                                    skillMap[key] = skill\
                                    totalLoadedCount++\
                                \}\
                            \}\
                        \}\
                    \}\
                \}\
            \} catch (e: Exception) \{\
                println("
\f8 \uc0\u9888 \u65039 
\f2  Fehler in Datei $\{file.name\}: $\{e.message\}")\
            \}\
        \}\
        return totalLoadedCount\
    \}\
\
    fun findAllLoadedSkills(): List<EscoSkill> = skillMap.values.distinctBy \{ it.uri \}.toList()\
    fun getSkillByLabel(label: String): EscoSkill? = skillMap[label.lowercase()]\
\}\
