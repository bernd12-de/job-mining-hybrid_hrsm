\f1\b0\fs24 \cf0 \strokec2 Zentralisiert das Mapping (SSoT) und die Level-Bestimmung (Ebene 2, 4, 5).\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Python\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \strokec2 from typing import Dict, Any, Optional\
from rapidfuzz import process, fuzz\
\
class HybridCompetenceRepository:\
    def __init__(self, esco_data, custom_domains):\
        self.esco_data = esco_data # Ebene 2\
        self.custom_domains = custom_domains # Ebene 4 & 5\
        self.blacklist = set()\
\
    def get_level(self, term: str) -> int:\
        """Bestimmt das wissenschaftliche Level (1-5) basierend auf der Dom\'e4ne."""\
        term_lower = term.lower()\
        if term_lower in self.custom_domains:\
            return self.custom_domains[term_lower].get('level', 4)\
        return 2 # Default ESCO\
\
    def is_digital_skill(self, term: str) -> bool:\
        """Ebene 3: Pr\'fcft auf Digitalisierungs-Hebel."""\
        return self.esco_data.get(term.lower(), \{\}).get('is_digital', False)\
\
    def get_data_by_label(self, label: str) -> Optional[Dict[str, Any]]:\
        """Fuzzy Matching zur Normalisierung auf ESCO-Labels."""\
        choices = list(self.esco_data.keys())\
        match = process.extractOne(label.lower(), choices, scorer=fuzz.token_set_ratio)\
        if match and match[1] >= 95:\
            return self.esco_data[match[0]]\
        return None\
\pard\pardeftab720\sa280\partightenfactor0

