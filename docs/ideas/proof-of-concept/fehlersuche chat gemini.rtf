\f1\b0\fs24 \cf0 \strokec2 Ersetze den Inhalt der Datei durch diesen Code. Er f\'fchrt die verschiedenen Skill-Quellen (ESCO + Fachbuch + Academia) korrekt f\'fcr SpaCy zusammen:\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Python\
\

\f2\fs26 \strokec2 import spacy\
from spacy.matcher import PhraseMatcher\
from typing import List, Any\
\
class SpaCyCompetenceExtractor:\
    def __init__(self, repository, manager, nlp_model=None):\
        self.repository = repository\
        self.manager = manager\
        # Modell laden (Stelle sicher, dass 'python -m spacy download de_core_news_md' ausgef\'fchrt wurde)\
        self.nlp = nlp_model or spacy.load("de_core_news_md")\
        self.matcher = PhraseMatcher(self.nlp.vocab, attr="LOWER")\
\
        # FIX: Alle Wissensquellen f\'fcr die SSoT-Patterns zusammenf\'fchren\
        # Wir kombinieren Ebene 2 (ESCO), Ebene 4 (Fachbuch) und Ebene 5 (Academia)\
        all_labels = (\
            list(self.repository.esco_data.keys()) + \
            list(self.repository._fachbuch_skills) + \
            list(self.repository._academia_skills)\
        )\
        \
        if all_labels:\
            patterns = list(self.nlp.pipe(all_labels))\
            self.matcher.add("KNOWLEDGE_BASE", patterns)\
\
    def extract_competences(self, text: str, role: str) -> List[Any]:\
        doc = self.nlp(text)\
        matches = self.matcher(doc)\
        results = []\
        seen = set()\
\
        for _, start, end in matches:\
            term = doc[start:end].text\
            term_lower = term.lower()\
            if term_lower in seen: continue\
            seen.add(term_lower)\
\
            # Daten \'fcber das Repository abrufen\
            esco_info = self.repository.esco_data.get(term_lower, \{\})\
\
            # Delegation an zentrale Factory im Manager\
            dto = self.manager.create_competence_dto(\
                original_term=term,\
                esco_label=term if term_lower in self.repository.esco_data else None,\
                esco_uri=esco_info.get('uri'),\
                level=self.repository.get_level(term),\
                is_digital=self.repository.is_digital_skill(term),\
                role_context=role\
            )\
            if dto: results.append(dto)\
        return results\
\pard\pardeftab720\sa280\partightenfactor0

