\f1\b0\fs24 \cf0 \strokec2 Ich habe den Konstruktor so angepasst, dass er die Pfad-Variablen akzeptiert, die du in der 
\f2\fs26 main.py
\f1\fs24  \'fcbergibst, und die 
\f2\fs26 rapid_fuzz
\f1\fs24  Logik f\'fcr Ebene 2 beibeh\'e4lt:\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Python\
\

\f2\fs26 \strokec2 import json\
import os\
from typing import Dict, Any, Optional, List\
from rapidfuzz import process, fuzz\
\
class HybridCompetenceRepository:\
    def __init__(self, esco_data_path: str, domains_path: str):\
        # Pfade speichern\
        self.esco_data_path = esco_data_path\
        self.domains_path = domains_path\
        \
        # Daten-Container\
        self.esco_data: Dict[str, Any] = \{\}       # Ebene 2 & 3\
        self.custom_domains: Dict[str, Any] = \{\}  # Ebene 4 & 5\
        self.blacklist = set()\
        \
        # Initiales Laden der Daten\
        self._load_all_data()\
\
    def _load_all_data(self):\
        """L\'e4dt ESCO-Stammdaten und lokale Dom\'e4nen-Dateien."""\
        # 1. ESCO Laden (Ebene 2)\
        if os.path.exists(self.esco_data_path):\
            with open(self.esco_data_path, 'r', encoding='utf-8') as f:\
                self.esco_data = json.load(f)\
                print(f"
\f8 \uc0\u9989 
\f2  Ebene 2: \{len(self.esco_data)\} ESCO-Labels geladen.")\
        \
        # 2. Lokale Dom\'e4nen Laden (Ebene 4 & 5)\
        # Wir laden alle JSONs aus dem Verzeichnis (z.B. fachbuch_domain.json)\
        if os.path.exists(self.domains_path):\
            for filename in os.listdir(self.domains_path):\
                if filename.endswith(".json"):\
                    path = os.path.join(self.domains_path, filename)\
                    with open(path, 'r', encoding='utf-8') as f:\
                        data = json.load(f)\
                        # Wir mergen die Daten in unsere custom_domains Map\
                        self.custom_domains.update(data)\
            print(f"
\f8 \uc0\u9989 
\f2  Ebene 4/5: \{len(self.custom_domains)\} Begriffe aus Fachb\'fcchern/Uni geladen.")\
\
    def get_level(self, term: str) -> int:\
        """Bestimmt das wissenschaftliche Level (1-5)."""\
        term_lower = term.lower()\
        \
        # Pr\'fcfung Ebene 5 & 4 (Custom Domains)\
        if term_lower in self.custom_domains:\
            return self.custom_domains[term_lower].get('level', 4)\
        \
        # Pr\'fcfung Ebene 3 & 2 (ESCO)\
        if term_lower in self.esco_data:\
            if self.esco_data[term_lower].get('is_digital', False):\
                return 3\
            return 2\
            \
        return 1 # Discovery / Marktinnovation\
\
    def is_digital_skill(self, term: str) -> bool:\
        """Ebene 3: Pr\'fcft auf Digitalisierungs-Hebel."""\
        # Erst in Custom Domains schauen, dann in ESCO\
        if term.lower() in self.custom_domains:\
            return self.custom_domains[term.lower()].get('is_digital', False)\
        return self.esco_data.get(term.lower(), \{\}).get('is_digital', False)\
\
    def get_data_by_label(self, label: str) -> Optional[Dict[str, Any]]:\
        """Fuzzy Matching zur Normalisierung auf ESCO-Labels."""\
        choices = list(self.esco_data.keys())\
        if not choices: return None\
        \
        match = process.extractOne(label.lower(), choices, scorer=fuzz.token_set_ratio)\
        if match and match[1] >= 95:\
            return self.esco_data[match[0]]\
        return None\
\pard\pardeftab720\sa280\partightenfactor0

