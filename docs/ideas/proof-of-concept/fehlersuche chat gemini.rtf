\cf0 \strokec2 Python\
\

\f2\fs26 \strokec2 import json\
import os\
import requests\
from typing import Dict, Any, Optional, List, Set\
from rapidfuzz import process, fuzz\
\
class HybridCompetenceRepository:\
    def __init__(self, kotlin_api_url: str, domains_path: str):\
        self.api_url = kotlin_api_url # z.B. http://localhost:8080\
        self.domains_path = domains_path\
        \
        # Daten-Container\
        self.esco_data: Dict[str, Any] = \{\}       # Ebene 2 & 3 (von Kotlin)\
        self.custom_domains: Dict[str, Any] = \{\}  # Ebene 4 & 5 (lokal)\
        \
        # Initialisierung\
        self.sync_from_kotlin()\
        self.load_local_domains()\
\
    def sync_from_kotlin(self):\
        """Holt ESCO-Daten live von der Kotlin-API."""\
        endpoint = f"\{self.api_url\}/api/v1/rules/esco-full"\
        try:\
            print(f"
\f8 \uc0\u55357 \u56580 
\f2  Synchronisiere ESCO-Basis von \{endpoint\}...")\
            response = requests.get(endpoint, timeout=10)\
            if response.status_code == 200:\
                data = response.json()\
                # Umwandlung in Dict f\'fcr schnellen Zugriff\
                for item in data:\
                    label = item['label'].lower()\
                    self.esco_data[label] = \{\
                        "uri": item.get('uri'),\
                        "is_digital": item.get('is_digital', False),\
                        "level": 2 if not item.get('is_digital') else 3\
                    \}\
                print(f"
\f8 \uc0\u9989 
\f2  SSoT-Sync erfolgreich: \{len(self.esco_data)\} Begriffe geladen.")\
        except Exception as e:\
            print(f"
\f8 \uc0\u9888 \u65039 
\f2  SSoT-Sync fehlgeschlagen: \{e\}. Nutze leere ESCO-Basis.")\
\
    def load_local_domains(self):\
        """L\'e4dt Ebene 4 & 5 aus dem lokalen Ordner."""\
        if os.path.exists(self.domains_path):\
            for filename in os.listdir(self.domains_path):\
                if filename.endswith(".json"):\
                    path = os.path.join(self.domains_path, filename)\
                    with open(path, 'r', encoding='utf-8') as f:\
                        self.custom_domains.update(json.load(f))\
            print(f"
\f8 \uc0\u9989 
\f2  Ebene 4/5: \{len(self.custom_domains)\} Begriffe geladen.")\
\
    def get_level(self, term: str) -> int:\
        """Bestimmt das Level (1-5)."""\
        t = term.lower()\
        if t in self.custom_domains:\
            return self.custom_domains[t].get('level', 4)\
        if t in self.esco_data:\
            return self.esco_data[t]["level"]\
        return 1 # Discovery\
\
    def is_digital_skill(self, term: str) -> bool:\
        """Pr\'fcft Ebene 3 Status."""\
        t = term.lower()\
        if t in self.custom_domains:\
            return self.custom_domains[t].get('is_digital', False)\
        return self.esco_data.get(t, \{\}).get('is_digital', False)\
\
    def get_data_by_label(self, label: str) -> Optional[Dict[str, Any]]:\
        """Fuzzy Matching auf die ESCO-Basis."""\
        choices = list(self.esco_data.keys())\
        if not choices: return None\
        match = process.extractOne(label.lower(), choices, scorer=fuzz.token_set_ratio)\
        if match and match[1] >= 95:\
            return self.esco_data[match[0]]\
        return None\
