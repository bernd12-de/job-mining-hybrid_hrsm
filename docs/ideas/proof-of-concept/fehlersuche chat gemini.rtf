\f2\fs26 \strokec2 import os\
import pypdf\
import json\
import re\
\
class ProfessionalAcademicExtractor:\
    def __init__(self):\
        # Deine bew\'e4hrte Blacklist erweitert um administrative Stoppw\'f6rter\
        self.blacklist = \{\
            "seite", "kapitel", "abbildung", "tabelle", "vorwort", "inhalt",\
            "anhang", "literatur", "index", "isbn", "verlag", "auflage",\
            "inhaltsverzeichnis", "herausgeber", "autor", "copyright",\
            "modul", "semester", "studiengang", "pr\'fcfung", "note"\
        \}\
\
    def _is_toc_page(self, text):\
        """Deine TOC-Erkennung: Sucht Marker in den ersten 600 Zeichen."""\
        if not text: return False\
        head = text[:600].lower()\
        return any(kw in head for kw in ["inhalt", "contents", "verzeichnis", "table of"])\
\
    def _clean_text(self, text):\
        """Deine Reinigungs-Logik + Schutz gegen PDF-Artefakte."""\
        if not text: return ""\
        # 1. Heile Worttrennungen und entferne Steuerzeichen (Fix f\'fcr 'kotlin_in_action')\
        text = text.replace('\\t', ' ').replace('\\x00', '').replace('', '')\
        text = re.sub(r'(\\w)-\\s+(\\w)', r'\\1\\2', text)\
        # 2. Deine TOC-Reinigung: Punkte und Seitenzahlen am Ende entfernen\
        text = re.sub(r'(\\.\\.\\.+|\\s\\.+\\s|\\s\\d+$)', '', text)\
        # 3. Kapitelnummern am Anfang entfernen (1.2.1)\
        text = re.sub(r'^\\d+(\\.\\d+)*\\s+', '', text)\
        return text.strip()\
\
    def _is_valid_academic_term(self, term):\
        """Der Qualit\'e4ts-Check: Verhindert 'M\'fcll' in der Masterarbeit."""\
        words = term.split()\
        # Nur Begriffe mit 1-4 W\'f6rtern (verhindert halbe S\'e4tze aus AngularJS Buch)\
        if not (1 <= len(words) <= 4): return False\
        # Muss mit Gro\'dfbuchstabe beginnen (Nomen-Check)\
        if not term[0].isupper(): return False\
        # Keine S\'e4tze (keine Satzzeichen am Ende)\
        if term.endswith(('.', ':', '?', '!')): return False\
        # Keine URLs oder ISBN-Nummern\
        if re.search(r'(http|www|\\d\{3\}-\\d)', term.lower()): return False\
        return True\
\
    def process_pdf(self, pdf_path, level):\
        file_name = os.path.basename(pdf_path)\
        print(f"
\f8 \uc0\u55357 \u56534 
\f2  Detaillierte Extraktion: \{file_name\}")\
        \
        try:\
            reader = pypdf.PdfReader(pdf_path)\
            competences = []\
            seen = set()\
            \
            # Scan der ersten 30 Seiten nach TOC\
            for i in range(min(30, len(reader.pages))):\
                page_text = reader.pages[i].extract_text()\
                if not self._is_toc_page(page_text): continue\
\
                for line in page_text.split('\\n'):\
                    cleaned = self._clean_text(line)\
                    \
                    if self._is_valid_academic_term(cleaned) and cleaned.lower() not in self.blacklist:\
                        if cleaned.lower() not in seen:\
                            # Hier nutzen wir DEINE detaillierte Struktur wieder\
                            competences.append(\{\
                                "name": cleaned,\
                                "original_chapter": cleaned,\
                                "level": level,\
                                "category": "Kapitelstruktur",\
                                "type": "topic_cluster",\
                                "source": file_name,\
                                "esco_uri": f"custom/lvl\{level\}/\{cleaned.lower().replace(' ', '_')\}"\
                            \})\
                            seen.add(cleaned.lower())\
\
            self._save(file_name, level, competences)\
            return len(competences)\
        except Exception as e:\
            print(f"
\f8 \uc0\u10060 
\f2  Fehler bei \{file_name\}: \{e\}")\
            return 0\
\
    def _save(self, filename, level, competences):\
        os.makedirs("data/job_domains", exist_ok=True)\
        safe_name = re.sub(r'\\W+', '_', filename.lower().replace('.pdf', ''))\
        path = f"data/job_domains/\{safe_name\}.json"\
        \
        output = \{\
            "domain": filename.replace('.pdf', '').replace('_', ' '),\
            "level": level,\
            "count": len(competences),\
            "competences": competences\
        \}\
        \
        with open(path, "w", encoding="utf-8") as f:\
            json.dump(output, f, indent=2, ensure_ascii=False)\
        print(f"   
\f8 \uc0\u9989 
\f2  \{len(competences)\} hochwertige Begriffe gespeichert.")\
\
def run_batch():\
    extractor = ProfessionalAcademicExtractor()\
    paths = \{"data/source_pdfs/fachbuecher": 4, "data/source_pdfs/modulhandbuecher": 5\}\
    for folder, lvl in paths.items():\
        if os.path.exists(folder):\
            for f in os.listdir(folder):\
                if f.endswith(".pdf"):\
                    extractor.process_pdf(os.path.join(folder, f), lvl)\
\
if __name__ == "__main__":\
    run_batch()\
