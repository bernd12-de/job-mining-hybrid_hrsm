\f2\fs26 \strokec2 import json\
import requests\
import os\
from typing import List, Set, Dict, Optional, Any\
from rapidfuzz import process, fuzz\
\
class HybridCompetenceRepository:\
    def __init__(self, \
                 kotlin_api_url: str = "http://localhost:8080", \
                 fachbuch_path: str = None, \
                 academia_path: str = None):\
        \
        self.api_url = kotlin_api_url\
        self.fachbuch_path = fachbuch_path\
        self.academia_path = academia_path\
\
        # Daten-Container\
        self.esco_data: Dict[str, Any] = \{\} # Ebene 2 & 3\
        self._fachbuch_skills: Set[str] = set() # Ebene 4\
        self._academia_skills: Set[str] = set() # Ebene 5\
        \
        # Initialisierung\
        self.sync_from_ssot()\
        self.load_local_domains()\
\
    def sync_from_ssot(self):\
        """Holt ESCO-Daten (Ebene 2 & 3) live von Kotlin."""\
        endpoint = f"\{self.api_url\}/api/v1/rules/esco-full"\
        try:\
            response = requests.get(endpoint, timeout=5)\
            if response.status_code == 200:\
                data = response.json()\
                for item in data:\
                    label = item['label'].lower()\
                    self.esco_data[label] = \{\
                        "uri": item.get('uri'),\
                        "is_digital": item.get('is_digital', False),\
                        "level": 3 if item.get('is_digital') else 2\
                    \}\
                print(f"
\f8 \uc0\u9989 
\f2  ESCO-Sync: \{len(self.esco_data)\} Begriffe geladen.")\
        except Exception as e:\
            print(f"
\f8 \uc0\u9888 \u65039 
\f2  Kotlin API offline unter \{self.api_url\}: \{e\}")\
\
    def load_local_domains(self):\
        """L\'e4dt Fachbuch und Academia Daten."""\
        if self.fachbuch_path and os.path.exists(self.fachbuch_path):\
            with open(self.fachbuch_path, 'r') as f:\
                self._fachbuch_skills = \{s.lower() for s in json.load(f)\}\
                print(f"
\f8 \uc0\u9989 
\f2  Ebene 4 geladen: \{len(self._fachbuch_skills)\} Begriffe.")\
\
        if self.academia_path and os.path.exists(self.academia_path):\
            with open(self.academia_path, 'r') as f:\
                self._academia_skills = \{s.lower() for s in json.load(f)\}\
                print(f"
\f8 \uc0\u9989 
\f2  Ebene 5 geladen: \{len(self._academia_skills)\} Begriffe.")\
\
    def get_level(self, term: str) -> int:\
        t = term.lower()\
        if t in self._academia_skills: return 5\
        if t in self._fachbuch_skills: return 4\
        if t in self.esco_data: return self.esco_data[t]["level"]\
        return 1\
\
    def is_digital_skill(self, term: str) -> bool:\
        return self.esco_data.get(term.lower(), \{\}).get('is_digital', False)\
\
    def get_data_by_label(self, label: str) -> Optional[Dict[str, Any]]:\
        """Fuzzy Suche f\'fcr den Extractor."""\
        choices = list(self.esco_data.keys())\
        if not choices: return None\
        match = process.extractOne(label.lower(), choices, scorer=fuzz.token_set_ratio)\
        if match and match[1] >= 95:\
            return self.esco_data[match[0]]\
        return None\
