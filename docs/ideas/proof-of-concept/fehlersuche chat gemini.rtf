\f3\b\fs28 \cf0 \strokec2 2. Warum 
\f4\fs30\fsmilli15210 \strokec2 md
\f3\fs28 \strokec2  statt 
\f4\fs30\fsmilli15210 \strokec2 sm
\f3\fs28 \strokec2 ?\
