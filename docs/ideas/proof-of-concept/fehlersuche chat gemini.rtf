import hashlib\
import logging\
from typing import BinaryIO, List\
from pathlib import Path\
from app.domain.models import AnalysisResultDTO\
\
logger = logging.getLogger(__name__)\
\
class JobMiningWorkflowManager:\
    """\
    Das Herzst\'fcck der Version 2. \
    Orchestriert die 7-Ebenen-Analyse unter Einbeziehung von Segmentierung.\
    """\
\
    def __init__(self, \
                 text_extractor, \
                 competence_extractor, \
                 organization_service, \
                 role_service, \
                 metadata_extractor):\
        self.text_extractor = text_extractor\
        self.competence_extractor = competence_extractor\
        self.organization_service = organization_service\
        self.role_service = role_service\
        self.metadata_extractor = metadata_extractor\
\
    def run_full_analysis(self, file_stream: BinaryIO, filename: str) -> AnalysisResultDTO:\
        """Einstiegspunkt f\'fcr Datei-Uploads (PDF/DOCX)."""\
        # 1. Schritt: Physikalisches Lesen\
        raw_text = self.text_extractor.extract_text(file_stream, filename)\
        \
        # Bereinigung f\'fcr Datenbank-Sicherheit (entfernt Null-Bytes)\
        cleaned_text = raw_text.replace('\\x00', '')\
        \
        return self._run_analysis_from_text(cleaned_text, filename)\
\
    def run_analysis_from_scraped_text(self, cleaned_text: str, url: str) -> AnalysisResultDTO:\
        """Einstiegspunkt f\'fcr Web-Scraping (LinkedIn/StepStone)."""\
        return self._run_analysis_from_text(cleaned_text, url)\
\
    def _run_analysis_from_text(self, text: str, source_name: str) -> AnalysisResultDTO:\
        """\
        DIESE METHODE ENTH\'c4LT DEINE VERBESSERTE LOGIK.\
        Hier findet die eigentliche wissenschaftliche Analyse statt.\
        """\
        # 1. Idempotenz-Check (Ebene 7)\
        # Erzeugt einen Fingerabdruck des Textes, um Duplikate in der DB zu vermeiden\
        raw_text_hash = hashlib.sha256(text.encode('utf-8')).hexdigest()\
\
        # 2. Schritt: Kontext & Metadaten (MetadataExtractor)\
        # Hier ziehen wir Datum, Titel und vor allem die SEGMENTE (Ebene 6)\
        meta = self.metadata_extractor.extract_all(text, source_name)\
\
        # 3. Schritt: Rollen- & Branchen-Zuordnung (via Kotlin SSoT)\
        # Wir nutzen die Services, um die Rolle (z.B. Assistenz) und die Branche festzulegen\
        industry = self.organization_service.classify_industry(text)\
        job_role = self.role_service.classify_role(text, meta.get('job_title', ''))\
\
        # 4. Schritt: Skill-Extraktion (Ebenen 1-5)\
        # WICHTIG: Deine 'bessere' Idee -> Wir nutzen den 'processing_text' (Segmentierung)!\
        # Falls die Segmentierung fehlschlug (is_segmented=False), nehmen wir den gesamten Text.\
        search_base = meta.get('processing_text') if meta.get('is_segmented') else text\
        \
        competences = self.competence_extractor.extract_competences(\
            search_base,\
            job_role # \'dcbergibt den Kontext f\'fcr die Ebenen-Validierung\
        )\
\
        # 5. Schritt: Zusammenbau zum DTO (Exakt abgestimmt auf Kotlin/Jackson)\
        return AnalysisResultDTO(\
            title=meta.get('job_title') or source_name,\
            job_role=job_role,\
            region=meta.get('location') or "Unbekannt",\
            industry=industry,\
            posting_date=meta.get('posting_date') or "2024-01-01",\
            raw_text_hash=raw_text_hash,\
            raw_text=text,\
            is_segmented=meta.get('is_segmented', False),\
            competences=competences\
        )\
\
    def process_local_directory(self, directory_path: str = "data/jobs") -> List[AnalysisResultDTO]:\
        """Batch-Verarbeitung f\'fcr die Zeitreihen-Analyse (2011-2024)."""\
        results = []\
        job_dir = Path(directory_path)\
        if not job_dir.exists():\
            logger.error(f"Verzeichnis nicht gefunden: \{job_dir.absolute()\}")\
            return []\
\
        for file_path in job_dir.glob("*.*"):\
            if file_path.suffix.lower() in ['.pdf', '.docx', '.txt']:\
                try:\
                    with open(file_path, "rb") as f:\
                        results.append(self.run_full_analysis(f, file_path.name))\
                except Exception as e:\
                    logger.error(f"Fehler bei \{file_path.name\}: \{e\}")\
        return results\
