\f3\b\fs28 \cf0 \strokec2 1. Die Implementierung: 
\f4\fs30\fsmilli15210 \strokec2 infrastructure/extractor/discovery_extractor.py
\f3\fs28 \strokec2 \
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 \strokec2 Dieser Extractor ben\'f6tigt Zugriff auf das Repository (um zu pr\'fcfen, ob ein Begriff schon bekannt ist) und den Manager (als Factory), um ein valides 
\f2\fs26 CompetenceDTO
\f1\fs24  zu erzeugen.\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Python\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \strokec2 # infrastructure/extractor/discovery_extractor.py\
\
from typing import List, Any\
import spacy\
# WICHTIG: Keine direkten DTO-Imports hier, wir nutzen die Factory des Managers!\
\
class DiscoveryExtractor:\
    """\
    Ebene 1 (Discovery): Identifiziert Begriffe, die weder in ESCO \
    noch in den Fachbuch-Dom\'e4nen vorhanden sind.\
    """\
\
    def __init__(self, repository, manager):\
        """\
        :param repository: Das HybridCompetenceRepository (SSoT)\
        :param manager: Der JobMiningWorkflowManager (Factory)\
        """\
        self.repository = repository\
        self.manager = manager\
\
    def extract_discoveries(self, doc: spacy.tokens.Doc) -> List[Any]:\
        """\
        Scannt ein SpaCy-Doc nach potenziellen neuen Kompetenzen.\
        """\
        discoveries = []\
        seen_in_doc = set()\
\
        for token in doc:\
            # Wissenschaftliche Filterkriterien f\'fcr Ebene 1:\
            # 1. Nur Nomen oder Eigennamen\
            # 2. Mindestens 5 Zeichen lang (vermeidet Abk\'fcrzungs-Rauschen)\
            # 3. Nicht in der Blacklist oder bereits bekannten Dom\'e4nen\
            \
            if token.pos_ in ["NOUN", "PROPN"] and len(token.text) >= 5:\
                term_lower = token.text.lower()\
                \
                if term_lower in seen_in_doc:\
                    continue\
                \
                # Check gegen die gesamte Wissensbasis (Ebene 2, 4, 5)\
                if not self.repository.is_known(term_lower):\
                    \
                    # KERN-FIX: Nutzung der zentralen Factory im Manager\
                    # Dies stellt sicher, dass level=1 (int) korrekt gesetzt wird.\
                    dto = self.manager.create_competence_dto(\
                        original_term=token.text,\
                        esco_label="Emergent Skill",\
                        esco_uri=f"discovery/\{term_lower\}",\
                        level=1,              # Ebene 1 Marktinnovation\
                        is_discovery=True,\
                        confidence_score=0.7, # Discovery ist unsch\'e4rfer als SSoT\
                        source_domain="Market Discovery"\
                    )\
                    \
                    if dto:\
                        discoveries.append(dto)\
                        seen_in_doc.add(term_lower)\
\
        return discoveries\
\pard\pardeftab720\sa280\partightenfactor0

\f3\b\fs28 \cf0 \strokec2 2. Warum diese Struktur wichtig ist (Absicherung)\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls174\ilvl0
\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Vermeidung von Zirkelbez\'fcgen:
\f1\b0  Indem der 
\f2\fs26 DiscoveryExtractor
\f1\fs24  das 
\f2\fs26 CompetenceDTO
\f1\fs24  nicht selbst importiert, sondern die Factory des Managers nutzt, verhinderst du Import-Fehler in Python.\
\ls174\ilvl0
\f3\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Zentrale Validierung:
\f1\b0  Die Factory im Manager pr\'fcft den Begriff automatisch gegen die 
\f2\fs26 GLOBAL_BLACKLIST
\f1\fs24  aus der 
\f2\fs26 constants.py
\f1\fs24 , bevor das Objekt f\'fcr Kotlin erstellt wird.\
\ls174\ilvl0
\f3\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Typ-Sicherheit:
\f1\b0  Das Feld 
\f2\fs26 level
\f1\fs24  wird hier explizit als 
\f2\fs26 int
\f1\fs24  (1) \'fcbergeben. Pydantic im Hintergrund stellt sicher, dass dieser Wert niemals als String an das Kotlin-Backend gesendet wird, was deine 
\f2\fs26 No value passed for parameter
\f1\fs24 -Fehler behebt.\
\pard\pardeftab720\sa280\partightenfactor0

