\f2\fs26 \cf0 \strokec2 package de.layher.jobmining.kotlinapi.services\
\
import de.layher.jobmining.kotlinapi.infrastructure.*\
import de.layher.jobmining.kotlinapi.infrastructure.bridge.PythonNlpBridge\
import de.layher.jobmining.kotlinapi.domain.Competence\
import org.springframework.stereotype.Service\
import org.springframework.transaction.annotation.Transactional\
\
@Service\
class HybridCompetenceService(\
    private val pythonBridge: PythonNlpBridge,\
    private val escoRepo: EscoDataRepository,\
    private val jobRepo: JobPostingRepository,\
    private val competenceRepo: CompetenceRepository,\
    private val ruleRepo: DomainRuleRepository\
) \{\
\
    @Transactional\
    fun processAndSave(jobId: Long, text: String, originalFileName: String) \{\
        // 1. Job laden\
        val job = jobRepo.findById(jobId).orElseThrow \{ Exception("Job $jobId nicht gefunden") \}\
\
        // 2. Dynamischer Aufruf: Statt "scan.txt" nutzen wir den echten Namen\
        // Dies ist wichtig f\'fcr den MetadataExtractor in Python (Ebene 7)\
        val analysisResult = pythonBridge.analyzeFull(text.toByteArray(), originalFileName)\
\
        // 3. Blacklist f\'fcr Ebene 1 (Discovery) laden\
        val blacklist = ruleRepo.findAllByRuleTypeAndIsActiveTrue("BLACKLIST")\
            .map \{ it.ruleKey.lowercase() \}.toSet()\
\
        // 4. Transformation auf das volle DB-Schema (Ebene 1-5)\
        val newCompetences = analysisResult.competences.mapNotNull \{ dto ->\
            val termLow = dto.originalTerm.lowercase()\
            if (blacklist.contains(termLow)) return@mapNotNull null\
\
            // Abgleich mit SSoT (Ebene 2 & 3)\
            val escoInfo = escoRepo.getSkillByLabel(dto.escoLabel)\
\
            Competence(\
                originalTerm = dto.originalTerm,\
                escoLabel = escoInfo?.preferredLabel ?: dto.escoLabel,\
                escoUri = escoInfo?.uri ?: dto.escoUri,\
                confidenceScore = dto.confidenceScore,\
                level = dto.level, // Ebene 1, 2, 4 oder 5\
                isDigital = escoInfo?.isDigital ?: dto.isDigital,\
                isDiscovery = (dto.level == 1),\
                sourceDomain = dto.sourceDomain ?: "Hybrid-Analysis",\
                roleContext = analysisResult.jobRole,\
                jobPosting = job\
            )\
        \}\
\
        competenceRepo.saveAll(newCompetences)\
        \
        // 5. Metadaten-Update am Job (Ebene 6)\
        job.isSegmented = analysisResult.isSegmented\
        job.jobRole = analysisResult.jobRole\
        jobRepo.save(job)\
    \}\
\}\
