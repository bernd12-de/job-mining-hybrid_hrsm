\cf0 \strokec2 Python\
\

\f2\fs26 \strokec2 import json\
import os\
import requests\
from typing import List, Set, Dict, Optional, Any\
from rapidfuzz import process, fuzz\
\
class HybridCompetenceRepository:\
    def __init__(self, \
                 kotlin_api_url: str, \
                 fachbuch_path: str, \
                 academia_path: str):\
        # Pfade und URL speichern\
        self.api_url = kotlin_api_url\
        self.fachbuch_path = fachbuch_path\
        self.academia_path = academia_path\
\
        # Daten-Container\
        self.esco_data: Dict[str, Any] = \{\}\
        self._fachbuch_skills: Set[str] = set()\
        self._academia_skills: Set[str] = set()\
\
        # Initialisierung\
        self.sync_from_ssot()\
        self.load_local_domains()\
\
    def sync_from_ssot(self):\
        """Holt ESCO-Daten (Ebene 2 & 3) live von Kotlin."""\
        endpoint = f"\{self.api_url\}/api/v1/rules/esco-full"\
        try:\
            response = requests.get(endpoint, timeout=10)\
            if response.status_code == 200:\
                data = response.json()\
                for item in data:\
                    label = item['label'].lower()\
                    self.esco_data[label] = \{\
                        "uri": item.get('uri'),\
                        "is_digital": item.get('is_digital', False),\
                        "level": 3 if item.get('is_digital') else 2\
                    \}\
                print(f"
\f8 \uc0\u9989 
\f2  SSoT-Sync: \{len(self.esco_data)\} ESCO-Labels geladen.")\
        except Exception as e:\
            print(f"
\f8 \uc0\u9888 \u65039 
\f2  SSoT-Sync fehlgeschlagen (Kotlin offline?): \{e\}")\
\
    def load_local_domains(self):\
        """L\'e4dt Ebene 4 & 5 aus den Pfaden."""\
        self._fachbuch_skills = self._load_json_to_set(self.fachbuch_path, "Fachbuch (Ebene 4)")\
        self._academia_skills = self._load_json_to_set(self.academia_path, "Academia (Ebene 5)")\
\
    def _load_json_to_set(self, path: str, label: str) -> Set[str]:\
        if os.path.exists(path):\
            with open(path, 'r', encoding='utf-8') as f:\
                data = json.load(f)\
                print(f"
\f8 \uc0\u9989 
\f2  \{label\} geladen: \{len(data)\} Begriffe.")\
                return \{s.lower() for s in data\}\
        return set()\
\
    def get_level(self, term: str) -> int:\
        """Bestimmt das wissenschaftliche Level (1-5)."""\
        t = term.lower()\
        if t in self._academia_skills: return 5\
        if t in self._fachbuch_skills: return 4\
        if t in self.esco_data:\
            return self.esco_data[t]["level"]\
        return 1 # Discovery\
\
    def is_digital_skill(self, term: str) -> bool:\
        """Ebene 3 Check."""\
        return self.esco_data.get(term.lower(), \{\}).get('is_digital', False)\
