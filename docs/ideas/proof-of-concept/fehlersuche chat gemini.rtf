\f3\b\fs24 \cf0 F\'fcr Docker (Cloud-Vorbereitung):\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0 \cf0 \strokec2 Erstelle oder erg\'e4nze dein 
\f2\fs26 Dockerfile
\f1\fs24  wie folgt. Das ist der Standardweg, um Playwright in Containern stabil zum Laufen zu bringen:\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Dockerfile\
\

\f2\fs26 \strokec2 FROM python:3.11-slim\
\
# System-Abh\'e4ngigkeiten f\'fcr Playwright & Postgres\
RUN apt-get update && apt-get install -y \\\
    libpq-dev gcc \\\
    && rm -rf /var/lib/apt/lists/*\
\
WORKDIR /app\
COPY requirements.txt .\
RUN pip install --no-cache-dir -r requirements.txt\
\
# Playwright Browser UND deren System-Abh\'e4ngigkeiten installieren\
RUN playwright install --with-deps chromium\
\
COPY . .\
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]\
\pard\pardeftab720\partightenfactor0

