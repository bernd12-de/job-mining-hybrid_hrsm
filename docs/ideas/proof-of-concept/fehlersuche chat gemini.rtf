\f2\fs26 \cf0 \strokec2 # app/infrastructure/extractor/metadata_extractor.py\
import re\
from typing import Dict, Optional\
\
class MetadataExtractor:\
    """\
    Segmentiert Stellenanzeigen (Ebene 6), um die Pr\'e4zision der \
    Kompetenzextraktion (Ebene 4/5) massiv zu erh\'f6hen.\
    """\
    def __init__(self):\
        # Muster f\'fcr die Aufgaben-Sektion\
        self.TASK_PATTERNS = [\
            r"(?i)(Ihre Aufgaben|Dein Aufgabengebiet|Was du machst|Das erwartet dich|Deine Rolle)"\
        ]\
        # Muster f\'fcr die Anforderungen-Sektion\
        self.REQ_PATTERNS = [\
            r"(?i)(Ihr Profil|Das bringst du mit|Qualifikationen|Was wir erwarten|Anforderungen)"\
        ]\
        # Muster f\'fcr das Ende der relevanten Sektionen (Firmenbenefits/Kontakt)\
        self.END_PATTERNS = [\
            r"(?i)(Wir bieten|Deine Benefits|Interesse geweckt|\'dcber uns|Kontakt)"\
        ]\
\
    def extract_all(self, text: str, filename: str) -> Dict:\
        """F\'fchrt die Segmentierung und Metadaten-Extraktion durch."""\
        \
        # 1. Titel-Heuristik (Erste Zeile oft Titel)\
        lines = [line.strip() for line in text.split('\\n') if line.strip()]\
        job_title = lines[0] if lines else filename\
\
        # 2. Segmentierung (Ebene 6)\
        tasks_text = ""\
        reqs_text = ""\
        \
        # Suche Startpunkte\
        task_start = self._find_first_match(self.TASK_PATTERNS, text)\
        req_start = self._find_first_match(self.REQ_PATTERNS, text)\
        end_start = self._find_first_match(self.END_PATTERNS, text)\
\
        # Logik: Extrahiere Text zwischen den Sektionen\
        if task_start != -1:\
            next_point = min([p for p in [req_start, end_start, len(text)] if p > task_start])\
            tasks_text = text[task_start:next_point]\
            \
        if req_start != -1:\
            next_point = min([p for p in [end_start, len(text)] if p > req_start])\
            reqs_text = text[req_start:next_point]\
\
        # processing_text ist die Summe der "Skill-reichen" Zonen\
        processing_text = (tasks_text + " " + reqs_text).strip()\
        is_segmented = len(processing_text) > 50\
\
        return \{\
            "job_title": job_title,\
            "organization": self._extract_org_simple(text),\
            "location": "Unbekannt", # K\'f6nnte \'fcber Regex verfeinert werden\
            "posting_date": "2024-01-01", \
            "is_segmented": is_segmented,\
            "processing_text": processing_text if is_segmented else text\
        \}\
\
    def _find_first_match(self, patterns: list, text: str) -> int:\
        for p in patterns:\
            match = re.search(p, text)\
            if match: return match.start()\
        return -1\
\
    def _extract_org_simple(self, text: str) -> str:\
        # Sehr einfache Heuristik f\'fcr den Firmennamen\
        match = re.search(r"(?i)(?:bei|an der)\\s+([A-Z][a-zA-Z\\s&]+(?:GmbH|AG|Group|KG|e\\.V\\.))", text)\
        return match.group(1) if match else "Unbekannt"\
