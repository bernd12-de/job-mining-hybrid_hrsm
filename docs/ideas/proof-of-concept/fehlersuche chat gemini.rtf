\f2\fs26 \cf0 \strokec2 # main.py\
import os\
import uvicorn\
from fastapi import FastAPI, UploadFile, File, Depends, HTTPException\
from typing import List\
\
# 1. Interfaces & Domain Models\
from app.domain.models import AnalysisResultDTO\
from app.interfaces.interfaces import IJobMiningWorkflowManager\
\
# 2. Infrastruktur (Repositories & Clients)\
from app.infrastructure.repositories.hybrid_competence_repository import HybridCompetenceRepository\
from app.infrastructure.clients.kotlin_rule_client import KotlinRuleClient\
from app.infrastructure.extractor.advanced_text_extractor import AdvancedTextExtractor\
\
# 3. Die 3 Spezial-Extractoren (Die "P\'e4sse")\
from app.infrastructure.extractor.spacy_extractor import SpaCyCompetenceExtractor\
from app.infrastructure.extractor.fuzzy_competence_extractor import FuzzyCompetenceExtractor\
from app.infrastructure.extractor.discovery_extractor import DiscoveryExtractor\
\
# 4. Orchestratoren & Services\
from app.infrastructure.extractor.competence_extractor import CompetenceExtractor\
from app.infrastructure.extractor.metadata_extractor import MetadataExtractor\
from app.application.services.organization_service import OrganizationService\
from app.application.services.role_service import RoleService\
from app.application.job_mining_workflow_manager import JobMiningWorkflowManager\
\
# =========================================================\
# INITIALISIERUNG DER KOMPONENTEN (Wissenschaftliches Setup)\
# =========================================================\
\
app = FastAPI(\
    title="Job Mining System v2 - Masterarbeit Edition",\
    description="Multi-Pass-Pipeline f\'fcr die 7-Ebenen-Kompetenzanalyse"\
)\
\
# A. Daten-Basis (SSoT)\
# Das Repo verbindet sich mit Kotlin und l\'e4dt die 31.655 ESCO-Labels\
# sowie deine generierten JSON-Dom\'e4nen f\'fcr Ebene 4 & 5.\
KOTLIN_URL = os.environ.get("KOTLIN_API_URL", "http://localhost:8080")\
repo = HybridCompetenceRepository(kotlin_api_url=KOTLIN_URL)\
repo.sync_from_ssot()\
repo.load_local_domains()\
\
# B. Die 3 NLP-Spezialisten (Strategy Pattern)\
spacy_ext = SpaCyCompetenceExtractor(repo)\
fuzzy_ext = FuzzyCompetenceExtractor(repo, threshold=92) # Tolerantes Matching f\'fcr Synonyme\
discovery_ext = DiscoveryExtractor(repo)               # Sucht nach Ebene 1 (Innovationen)\
\
# C. Der Master-Extractor (Orchestriert die P\'e4sse 1-3)\
chef_extractor = CompetenceExtractor(\
    spacy_ext=spacy_ext,\
    fuzzy_ext=fuzzy_ext,\
    discovery_ext=discovery_ext\
)\
\
# D. Regel-Services (Branchen- und Rollenlogik)\
rule_client = KotlinRuleClient()\
org_service = OrganizationService(rule_client=rule_client)\
role_service = RoleService(rule_client=rule_client)\
\
# E. Der Workflow Manager (Zusammenbau der 7 Ebenen)\
# Nutzt jetzt den neuen MetadataExtractor f\'fcr die Segmentierung (Ebene 6)\
workflow_manager = JobMiningWorkflowManager(\
    text_extractor=AdvancedTextExtractor(),\
    competence_extractor=chef_extractor,\
    organization_service=org_service,\
    role_service=role_service,\
    metadata_extractor=MetadataExtractor()\
)\
\
# =========================================================\
# API ENDPUNKTE\
# =========================================================\
\
@app.post("/analyse", response_model=AnalysisResultDTO)\
async def analyse_document(file: UploadFile = File(...)):\
    """\
    Vollst\'e4ndiger Analyse-Durchlauf:\
    1. Physikalisches Lesen (PDF/DOCX)\
    2. Segmentierung in Aufgaben/Anforderungen (Ebene 6)\
    3. Multi-Pass Extraktion (Ebenen 1-5)\
    4. SSoT-Validierung & Level-Zuweisung\
    """\
    try:\
        # Wir \'fcbergeben den Stream und den Dateinamen an den Manager\
        result = workflow_manager.run_full_analysis(file.file, file.filename)\
        return result\
    except Exception as e:\
        print(f"
\f8 \uc0\u10060 
\f2  Schwerer Analysefehler: \{str(e)\}")\
        raise HTTPException(status_code=500, detail=str(e))\
\
@app.get("/health")\
async def health_check():\
    """Pr\'fcft die Integrit\'e4t der ESCO-Datenbasis."""\
    label_count = len(repo.get_all_skills())\
