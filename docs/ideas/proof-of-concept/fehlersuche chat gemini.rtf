\f1\b0\fs24 \cf0 \strokec2 W\'fcrdest du 
\f2\fs26 jobRole
\f1\fs24  als 
\f2\fs26 val
\f1\fs24  belassen, m\'fcsstest du:\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls232\ilvl0\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	1	}\expnd0\expndtw0\kerning0
