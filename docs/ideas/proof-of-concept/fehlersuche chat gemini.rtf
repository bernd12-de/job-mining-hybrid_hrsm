\f2\fs26 \cf0 \strokec2 class DiscoveryExtractor:\
    def __init__(self, repository, manager):\
        self.repository = repository\
        self.manager = manager\
\
    def extract(self, doc) -> List[Any]:\
        discoveries = []\
        for token in doc:\
            # Nur unbekannte Nomen/Eigennamen (Ebene 1)\
            if token.pos_ in ["NOUN", "PROPN"] and len(token.text) > 4:\
                term_lower = token.text.lower()\
                if not self.repository.is_known(term_lower):\
                    dto = self.manager.create_competence_dto(\
                        original_term=token.text,\
                        esco_label="Emergent Skill",\
                        esco_uri=f"discovery/\{term_lower\}",\
                        level=1, # Festgelegt f\'fcr Discovery\
                        is_discovery=True\
                    )\
                    if dto: discoveries.append(dto)\
        return discoveries\
