import hashlib\
import logging\
from typing import BinaryIO\
from app.domain.models import AnalysisResultDTO\
\
logger = logging.getLogger(__name__)\
\
class JobMiningWorkflowManager:\
    def __init__(self, text_extractor, competence_extractor, organization_service, role_service, metadata_extractor):\
        self.text_extractor = text_extractor\
        self.competence_extractor = competence_extractor\
        self.organization_service = organization_service\
        self.role_service = role_service\
        self.metadata_extractor = metadata_extractor\
\
    def run_full_analysis(self, file_stream: BinaryIO, filename: str) -> AnalysisResultDTO:\
        """\
        Orchestriert die 5 Schritte der Analyse-Pipeline f\'fcr die Masterarbeit.\
        """\
        # 1. Schritt: Physikalisches Lesen\
        raw_text = self.text_extractor.extract_text(file_stream, filename)\
        if not raw_text:\
            logger.error(f"Konnte keinen Text aus \{filename\} extrahieren.")\
            raw_text = "Extraktion fehlgeschlagen"\
\
        # Bereinigung von Null-Bytes f\'fcr die DB-Kompatibilit\'e4t\
        cleaned_text = raw_text.replace('\\x00', '')\
        \
        # Erzeuge Hash f\'fcr Idempotenz (Ebene 7)\
        raw_text_hash = hashlib.sha256(cleaned_text.encode('utf-8')).hexdigest()\
\
        # 2. Schritt: Kontext & Metadaten (Extrahiert Segmente f\'fcr Ebene 6)\
        # Liefert: job_title, organization, location, processing_text (Segmente), is_segmented, posting_date\
        meta = self.metadata_extractor.extract_all(cleaned_text, filename)\
\
        # 3. Schritt: Branchen- & Rollen-Zuordnung via SSoT (Kotlin Rules)\
        # Wir nutzen die Metadaten, um die Branchen-Regeln anzuwenden\
        industry = self.organization_service.classify_industry(cleaned_text)\
        \
        # Bestimme die Rolle (Wichtig f\'fcr den Kompetenz-Kontext)\
        job_role = self.role_service.classify_role(cleaned_text, meta.get('job_title', ''))\
\
        # 4. Schritt: Skill-Extraktion (Ebenen 1-5)\
        # WICHTIG: Wir nutzen meta['processing_text'], falls die Segmentierung \
        # erfolgreich war (nur Aufgaben/Anforderungen), sonst den cleaned_text.\
        search_base = meta.get('processing_text') if meta.get('is_segmented') else cleaned_text\
        \
        competences = self.competence_extractor.extract_competences(\
            search_base,\
            job_role # \'dcbergibt Kontext f\'fcr Ebene 4/5 Validierung\
        )\
\
        # 5. Schritt: Zusammenbau zum DTO (Exakt f\'fcr Kotlin/Jackson)\
        return AnalysisResultDTO(\
            title=meta.get('job_title') or filename,\
            job_role=job_role,\
            region=meta.get('location') or "Unbekannt",\
            industry=industry,\
            posting_date=meta.get('posting_date') or "2024-01-01", # Nutzt extrahiertes Datum\
            raw_text_hash=raw_text_hash,\
            raw_text=cleaned_text,\
            is_segmented=meta.get('is_segmented', False),\
            competences=competences\
        )\
