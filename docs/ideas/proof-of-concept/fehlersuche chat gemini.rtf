import de.layher.jobmining.kotlinapi.domain.EscoSkill\
import de.layher.jobmining.kotlinapi.infrastructure.io.IOService\
import org.springframework.stereotype.Repository\
import org.springframework.beans.factory.annotation.Value\
import java.util.concurrent.ConcurrentHashMap\
import jakarta.annotation.PostConstruct\
import java.io.File\
\
@Repository\
class EscoDataRepository(\
    private val ioService: IOService,\
    @Value("\\$\{app.esco.data-path:./data/esco\}") private val escoFolderPath: String\
) \{\
    private val skillMap = ConcurrentHashMap<String, EscoSkill>()\
\
    @PostConstruct\
    fun init() \{\
        val totalLoaded = loadAllFromFolder()\
        if (totalLoaded < 15000) \{ // Versch\'e4rfter Check f\'fcr 31k Ziel\
            throw IllegalStateException("
\f8 \uc0\u9888 \u65039 
\f2  INTEGRIT\'c4TSFEHLER: Nur $totalLoaded Labels geladen. Synonym-Split pr\'fcfen!")\
        \}\
        println("
\f8 \uc0\u9989 
\f2  SSoT bereit: $totalLoaded Begriffe (inkl. Synonyme) geladen.")\
    \}\
\
    fun loadAllFromFolder(): Int \{\
        var count = 0\
        val folder = File(escoFolderPath)\
        if (!folder.exists()) return 0\
\
        folder.listFiles \{ f -> f.extension == "csv" && !f.name.contains("occupation") \}?.forEach \{ file ->\
            file.bufferedReader().useLines \{ lines ->\
                lines.drop(1).forEach \{ line ->\
                    val cols = line.split(",") \
                    if (cols.size >= 6) \{\
                        val uri = cols[1].replace("\\"", "").trim()\
                        val prefLabel = cols[4].replace("\\"", "").trim()\
                        val altLabelsRaw = cols[5].replace("\\"", "").trim()\
\
                        // Expansion: Jedes Synonym wird ein eigener Key\
                        val allTerms = mutableListOf(prefLabel)\
                        if (altLabelsRaw.isNotEmpty()) \{\
                            allTerms.addAll(altLabelsRaw.split("|").map \{ it.trim() \})\
                        \}\
\
                        allTerms.forEach \{ term ->\
                            val key = term.lowercase()\
                            // S-Killer Fix: Verhindert Rauschen, erlaubt wichtige IT-K\'fcrzel\
                            if (term.length >= 3 || key in listOf("ux", "ui", "it", "ki", "sm")) \{\
                                if (!skillMap.containsKey(key)) \{\
                                    skillMap[key] = EscoSkill(uri, prefLabel, emptyList())\
                                    count++\
                                \}\
                            \}\
                        \}\
                    \}\
                \}\
            \}\
        \}\
        return count\
    \}\
\
    fun getSkillByLabel(label: String): EscoSkill? = skillMap[label.lowercase()]\
    fun findAllLoadedSkills(): List<EscoSkill> = skillMap.values.distinctBy \{ it.uri \}\
\}\
