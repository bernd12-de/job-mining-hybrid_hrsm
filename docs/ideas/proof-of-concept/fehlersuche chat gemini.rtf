\f2\fs26 \strokec2 import os\
import pypdf\
import json\
import re\
from pathlib import Path\
\
class ProfessionalDomainGenerator:\
    def __init__(self):\
        self.blacklist = \{"inhalt", "vorwort", "kapitel", "literatur", "index", "anhang"\}\
\
    def _clean_text(self, text):\
        if not text: return ""\
        text = re.sub(r'(\\w)-\\s+(\\w)', r'\\1\\2', text) # Heile Trennungen\
        text = re.sub(r'^\\d+(\\.\\d+)*\\s+', '', text)   # Entferne Nummern\
        text = re.sub(r'\\.\{2,\}\\s*\\d+', '', text)      # Entferne TOC-Punkte/Seiten\
        return text.strip()\
\
    def process_dir(self, source_dir, level):\
        path = Path(source_dir)\
        if not path.exists(): return\
        \
        all_terms = set()\
        print(f"
\f8 \uc0\u55357 \u56589 
\f2  Scanne Ebene \{level\} in \{source_dir\}...")\
        \
        for pdf_file in path.glob("*.pdf"):\
            reader = pypdf.PdfReader(pdf_file)\
            # Wir lesen die ersten 20 Seiten (Inhaltsverzeichnis)\
            for i in range(min(20, len(reader.pages))):\
                text = reader.pages[i].extract_text()\
                if not text: continue\
                for line in text.split('\\n'):\
                    cleaned = self._clean_text(line)\
                    if len(cleaned) > 5 and cleaned.lower() not in self.blacklist:\
                        all_terms.add(cleaned)\
\
        # Speichere als flache Liste f\'fcr das HybridCompetenceRepository\
        output_name = "fachbuch_domain.json" if level == 4 else "academia_domain.json"\
        output_path = Path("data/job_domains") / output_name\
        output_path.parent.mkdir(parents=True, exist_ok=True)\
        \
        with open(output_path, "w", encoding="utf-8") as f:\
            json.dump(list(all_terms), f, ensure_ascii=False, indent=4)\
        print(f"
\f8 \uc0\u9989 
\f2  JSON gespeichert: \{output_path\} (\{len(all_terms)\} Begriffe)")\
\
if __name__ == "__main__":\
    gen = ProfessionalDomainGenerator()\
    gen.process_dir("data/source_pdfs/fachbuecher", 4)\
    gen.process_dir("data/source_pdfs/modulhandbuecher", 5)\
