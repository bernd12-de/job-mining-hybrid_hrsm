\f1\b0\fs24 \cf0 \strokec2 Diese Klasse konzentriert sich nun rein auf das NLP-Matching und delegiert die Objekterstellung an den Manager.\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 Python\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \strokec2 # app/infrastructure/extractor/spacy_competence_extractor.py\
\
from typing import List\
import spacy\
from spacy.matcher import PhraseMatcher\
from app.interfaces.interfaces import ICompetenceExtractor\
from app.domain.models import CompetenceDTO\
\
class SpaCyCompetenceExtractor(ICompetenceExtractor):\
    """\
    Pass 1 der Analyse: Nutzt SpaCy PhraseMatcher f\'fcr exakte Treffer \
    gegen die SSoT (Ebene 2) sowie Fachbuch/Uni-Dom\'e4nen (Ebene 4/5).\
    """\
\
    def __init__(self, repository, manager, nlp_model=None):\
        self.repository = repository\
        self.manager = manager  # Die zentrale Factory\
        self.nlp = nlp_model or spacy.load("de_core_news_md")\
        self.matcher = PhraseMatcher(self.nlp.vocab, attr="LOWER")\
\
        # Laden der Wissensbasis (ESCO + Domains)\
        # Repository liefert alle Labels f\'fcr Ebenen 2, 4 und 5\
        self.reference_labels = list(self.repository.get_all_skills())\
        \
        # Matcher effizient f\'fcllen\
        patterns = list(self.nlp.pipe(self.reference_labels))\
        self.matcher.add("COMPETENCE_KNOWLEDGE_BASE", patterns)\
        \
        print(f"*** 
\f8 \uc0\u9989 
\f2  SpaCy Matcher mit \{len(patterns)\} Begriffen initialisiert. ***")\
\
    def extract_competences(self, text: str, role: str) -> List[CompetenceDTO]:\
        """\
        Extrahiert bekannte Kompetenzen aus dem Text.\
        """\
        if not text or len(text) < 5:\
            return []\
\
        doc = self.nlp(text)\
        matches = self.matcher(doc)\
        found_dtos = []\
        seen_terms = set()\
\
        for match_id, start, end in matches:\
            span = doc[start:end]\
            term = span.text.strip()\
            term_lower = term.lower()\
\
            # Dubletten-Check innerhalb einer Anzeige\
            if term_lower in seen_terms:\
                continue\
            seen_terms.add(term_lower)\
\
            # --- WISSENSCHAFTLICHE DATENABFRAGE ---\
            # Wir holen alle Metadaten zentral aus dem Hybrid-Repository\
            repo_data = self.repository.get_data_by_label(term)\
            if not repo_data:\
                continue\
\
            # --- ZENTRALE FACTORY NUTZEN (Absicherung Python-Seite) ---\
            # Anstatt CompetenceDTO(...) selbst zu bauen, rufen wir den Manager auf.\
            # Dies garantiert, dass Typen (int) und Blacklists stimmen.\
            dto = self.manager.create_competence_dto(\
                original_term=term,\
                esco_label=repo_data.get("preferredLabel", term),\
                esco_uri=repo_data.get("uri", f"custom/\{term_lower\}"),\
                confidence_score=1.0,\
                # Das Level (2, 4 oder 5) kommt direkt aus dem Repo-Mapping\
                level=self.repository.get_level(term_lower),\
                # Ebene 3 Hering (Digitalisierung)\
                is_digital=self.repository.is_digital_skill(term_lower),\
                is_discovery=False,\
                role_context=role,\
                source_domain=repo_data.get("source_domain", "Stellenanzeige")\
            )\
\
            if dto:\
                found_dtos.append(dto)\
\
        return found_dtos\
\pard\pardeftab720\sa280\partightenfactor0

