\f2\fs26 \strokec2 import os\
import pypdf\
import json\
import re\
\
class ScientificTOCExtractor:\
    def __init__(self):\
        # Filtert administrative Begriffe aus Modulhandb\'fcchern und B\'fcchern\
        self.blacklist = \{\
            "seite", "kapitel", "abbildung", "tabelle", "vorwort", "inhalt",\
            "anhang", "literatur", "index", "isbn", "verlag", "auflage",\
            "modul", "semester", "studiengang", "pr\'fcfung", "note", "autor",\
            "impressum", "glossar", "stichwortverzeichnis", "herausgeber"\
        \}\
\
    def _is_toc_page(self, text):\
        """Pr\'fcft, ob eine Seite ein Inhaltsverzeichnis ist (TOC-Marker)."""\
        if not text: return False\
        # Pr\'fcfe die ersten 600 Zeichen der Seite auf TOC-Keywords\
        head = text[:600].lower()\
        toc_keywords = ["inhalt", "contents", "verzeichnis", "table of"]\
        return any(kw in head for kw in toc_keywords)\
\
    def _clean_line(self, line):\
        """Entfernt Seitenzahlen, Punktreihen und Kapitelnummern."""\
        # 1. Entferne Punktreihen und Seitenzahlen am Ende (z.B. "API ... 124")\
        line = re.sub(r'(\\.\\.\\.+|\\s\\.+\\s|\\s\\d+$)', '', line)\
        # 2. Entferne Kapitelnummern am Anfang (z.B. 1.2.1 )\
        line = re.sub(r'^\\d+(\\.\\d+)*\\s+', '', line)\
        # 3. Entferne Tabulatoren und Steuerzeichen (Fix f\'fcr 'kotlin_in_action')\
        line = line.replace('\\t', ' ').replace('\\x00', '').strip()\
        return line\
\
    def _is_valid_skill(self, term):\
        """Wissenschaftlicher Qualit\'e4ts-Filter: 1-4 W\'f6rter, Start mit Gro\'dfbuchstabe."""\
        words = term.split()\
        # Nur Begriffe mit 1-4 W\'f6rtern (keine S\'e4tze)\
        if not (1 <= len(words) <= 4): return False\
        # Muss mit Gro\'dfbuchstabe beginnen (Nomen-Check)\
        if not term[0].isupper(): return False\
        # Darf nicht auf Satzzeichen enden\
        if term.endswith(('.', ':', '?', '!')): return False\
        return True\
\
    def process_pdf(self, pdf_path, level):\
        file_name = os.path.basename(pdf_path)\
        print(f"
\f8 \uc0\u55357 \u56534 
\f2  Suche Inhaltsverzeichnis in: \{file_name\}")\
        \
        try:\
            reader = pypdf.PdfReader(pdf_path)\
            competences = []\
            seen = set()\
            \
            # 1. Identifiziere TOC-Seiten (Scan der ersten 30 Seiten)\
            toc_indices = []\
            for i in range(min(30, len(reader.pages))):\
                if self._is_toc_page(reader.pages[i].extract_text()):\
                    toc_indices.append(i)\
\
            if not toc_indices:\
                print(f"   
\f8 \uc0\u9888 \u65039 
\f2  Kein Inhaltsverzeichnis gefunden f\'fcr \{file_name\}!")\
                return 0\
\
            # 2. Extrahiere NUR von gefundenen TOC-Seiten\
            for p_idx in toc_indices:\
                text = reader.pages[p_idx].extract_text()\
                for line in text.split('\\n'):\
                    cleaned = self._clean_line(line)\
                    \
                    if self._is_valid_skill(cleaned) and cleaned.lower() not in self.blacklist:\
                        if cleaned.lower() not in seen:\
                            competences.append(\{\
                                "name": cleaned,\
                                "level": level,\
                                "source": file_name,\
                                "esco_uri": f"custom/lvl\{level\}/\{cleaned.lower().replace(' ', '_')\}"\
                            \})\
                            seen.add(cleaned.lower())\
\
            self._save(file_name, level, competences)\
            return len(competences)\
        except Exception as e:\
            print(f"   
\f8 \uc0\u10060 
\f2  Fehler: \{e\}")\
            return 0\
\
    def _save(self, filename, level, competences):\
        os.makedirs("data/job_domains", exist_ok=True)\
        safe_name = re.sub(r'\\W+', '_', filename.lower().replace('.pdf', ''))\
        path = f"data/job_domains/\{safe_name\}.json"\
        output = \{\
            "domain": filename.replace('.pdf', '').replace('_', ' '),\
            "level": level,\
            "count": len(competences),\
            "competences": competences\
        \}\
        with open(path, "w", encoding="utf-8") as f:\
            json.dump(output, f, indent=2, ensure_ascii=False)\
        print(f"   
\f8 \uc0\u9989 
\f2  \{len(competences)\} TOC-Begriffe gespeichert.")\
\
def run_batch():\
    extractor = ScientificTOCExtractor()\
    paths = \{\
        "data/source_pdfs/fachbuecher": 4, \
        "data/source_pdfs/modulhandbuecher": 5\
    \}\
    for folder, lvl in paths.items():\
        if os.path.exists(folder):\
            for f in os.listdir(folder):\
                if f.endswith(".pdf"):\
                    extractor.process_pdf(os.path.join(folder, f), lvl)\
\
if __name__ == "__main__":\
    run_batch()\
