class MetadataExtractor:\
    """\
    Wissenschaftlicher Extraktor: Verliert keine Felder und nutzt \
    gierige Regex f\'fcr die Segmentierung (Ebene 6).\
    """\
\
    def __init__(self):\
        # Deine neuen, verbesserten Muster (Bleiben erhalten!)\
        self.TASK_PATTERN = re.compile(\
            r'(?:DEINE AUFGABEN|T\'c4TIGKEITEN|WAS DU BEI UNS MACHST|YOUR TASKS|RESPONSIBILITIES|TASKS)[\\s\\r\\n:.-]+(.*?)(?=(?:DEIN PROFIL|PROFIL|REQUIREMENTS|WIR BIETEN|WIR SUCHEN|BENEFITS|ABOUT US|$))',\
            re.DOTALL | re.IGNORECASE)\
\
        self.REQ_PATTERN = re.compile(\
            r'(?:PROFIL|DEIN PROFIL|YOUR PROFILE|ANFORDERUNGEN|REQUIREMENTS|QUALIFICATIONS|VORAUSSETZUNGEN|SKILLSET)[\\s\\r\\n:.-]+(.*?)(?=(?:DEINE AUFGABEN|TASKS|WIR BIETEN|WIR SUCHEN|BENEFITS|KONTAKT|$))',\
            re.DOTALL | re.IGNORECASE)\
\
        # Branchen-Muster f\'fcr das Feld 'industry'\
        self.industry_patterns = \{\
            "Versicherungswesen": r"(Versicherung|Hdi|Allianz|Munich Re|Debeka)",\
            "IT & Software": r"(Software|IT-Dienstleister|Entwicklung|Technologie)",\
            "Industrie & Bau": r"(Materna|Strabag|Bauwesen|Fertigung)"\
        \}\
\
    def extract_all(self, text: str, filename: str, filepath: str = "") -> Dict:\
        """Extrahiert alle Felder, ohne Daten zu l\'f6schen."""\
        \
        # 1. Sektions-Extraktion (Ebene 6)\
        tasks_match = self.TASK_PATTERN.search(text)\
        reqs_match = self.REQ_PATTERN.search(text)\
        \
        clean_segment = ""\
        if tasks_match: clean_segment += tasks_match.group(1).strip()\
        if reqs_match: clean_segment += " " + reqs_match.group(1).strip()\
        \
        is_segmented = len(clean_segment) > 50\
\
        # 2. Level-Inferenz (Wichtig: Bestimmt Ebene 4 oder 5)\
        inferred_level = 2\
        source_domain = "Stellenanzeige"\
        if "fachbuecher" in filepath.lower():\
            inferred_level = 4\
            source_domain = f"Fachbuch: \{filename\}"\
        elif "modulhandbuecher" in filepath.lower():\
            inferred_level = 5\
            source_domain = f"Academia: \{filename\}"\
\
        # 3. Das vollst\'e4ndige Daten-Set zur\'fcckgeben (Nichts geht verloren)\
        return \{\
            "job_title": self._extract_title(text, filename),\
            "organization": self._extract_org(text),\
            "location": self._extract_location(text),\
            "posting_date": self._extract_date(text), # Wichtig f\'fcr 2011-2024 Analyse!\
            "is_segmented": is_segmented,\
            "processing_text": clean_segment if is_segmented else text,\
            "inferred_level": inferred_level,\
            "source_domain": source_domain,\
            "industry": self._detect_industry(text)\
        \}\
\
    def _extract_title(self, text: str, filename: str) -> str:\
        lines = text.split('\\n')\
        return lines[0].strip() if lines and len(lines[0]) > 5 else filename\
\
    def _extract_org(self, text: str) -> str:\
        match = re.search(r'([A-Z][a-z\'e4\'f6\'fc\'df]+\\s(AG|GmbH|Group|KG))', text[:800])\
        return match.group(0) if match else "Unbekannt"\
\
    def _extract_location(self, text: str) -> str:\
        # Einfache Suche nach Gro\'dfst\'e4dten f\'fcr die 'region' Spalte\
        match = re.search(r'(Hannover|Berlin|K\'f6ln|M\'fcnchen|Hamburg|Frankfurt)', text, re.I)\
        return match.group(0) if match else "Deutschland"\
\
    def _extract_date(self, text: str) -> str:\
        # Sucht Datumsformate (JJJJ-MM-DD oder DD.MM.JJJJ)\
        match = re.search(r'(\\d\{2\}\\.\\d\{2\}\\.\\d\{4\})', text)\
        if match: return match.group(1)\
        return "2024-01-01" # Default\
\
    def _detect_industry(self, text: str) -> str:\
        for ind, pat in self.industry_patterns.items():\
            if re.search(pat, text, re.I): return ind\
        return "Sonstige"\
