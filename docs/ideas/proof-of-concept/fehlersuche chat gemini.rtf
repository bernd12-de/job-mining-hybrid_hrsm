\f2\fs26 \cf0 \strokec2 # app/infrastructure/extractor/discovery_extractor.py\
import spacy\
from app.domain.models import CompetenceDTO\
\
class DiscoveryExtractor:\
    def __init__(self, repository):\
        self.repo = repository\
        self.nlp = spacy.load("de_core_news_md")\
        # Wir laden die Blacklist aus Kotlin, um Rauschen zu vermeiden\
        self.blacklist = set(self.repo.get_blacklist())\
\
    def extract(self, text: str) -> list[CompetenceDTO]:\
        doc = self.nlp(text)\
        discoveries = []\
        \
        # Wir suchen nach Nomen und Eigennamen, die unbekannt sind\
        for token in doc:\
            if token.pos_ in ["NOUN", "PROPN"] and len(token.text) > 3:\
                term_low = token.text.lower()\
                \
                # Check: Nicht in Blacklist UND nicht in ESCO/B\'fcchern\
                if term_low not in self.blacklist and not self.repo.exists_in_ssot(term_low):\
                    discoveries.append(CompetenceDTO(\
                        original_term=token.text,\
                        esco_label=f"Neu: \{token.text\}",\
                        esco_uri=f"discovery://\{term_low\}",\
                        level=1, # Ebene 1: Innovation\
                        is_discovery=True,\
                        confidence_score=0.7,\
                        source_domain="Discovery-Mining"\
                    ))\
        return discoveries\
