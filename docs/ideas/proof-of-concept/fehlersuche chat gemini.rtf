import os\
from pathlib import Path\
from app.application.job_mining_workflow_manager import JobMiningWorkflowManager\
\
def run_flat_batch_analysis(folder_path: str = "data/all_jobs"):\
    """\
    Verarbeitet alle Dateien in einem einzigen Ordner und \
    extrahiert das Jahr individuell pro Dokument.\
    """\
    job_dir = Path(folder_path)\
    if not job_dir.exists():\
        print(f"
\f8 \uc0\u10060 
\f2  Pfad \{folder_path\} nicht gefunden!")\
        return\
\
    # Initialisierung des Managers (wie in main.py)\
    # manager = ... \
\
    for file_path in job_dir.glob("*.*"):\
        if file_path.suffix.lower() in [".pdf", ".docx"]:\
            print(f"
\f8 \uc0\u55357 \u56589 
\f2  Analysiere: \{file_path.name\}")\
            try:\
                with open(file_path, "rb") as f:\
                    # Der Manager nutzt den MetadataExtractor, um das Jahr \
                    # aus dem Text oder dem Namen zu finden (Ebene 7)\
                    result = manager.run_full_analysis(f, file_path.name, str(file_path))\
                    \
                    # Speichern in Kotlin\
                    save_to_database(result)\
                    print(f"   
\f8 \uc0\u9989 
\f2  Jahr erkannt: \{result.posting_date\}")\
            except Exception as e:\
                print(f"   
\f8 \uc0\u10060 
\f2  Fehler: \{e\}")\
\
def save_to_database(dto):\
    import requests\
    requests.post("http://localhost:8080/api/v1/jobs/save-analysis", json=dto.dict())\
\
if __name__ == "__main__":\
    run_flat_batch_analysis()\
