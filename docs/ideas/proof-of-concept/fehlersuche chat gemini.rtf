\f2\fs26 \cf0 \strokec2 # infrastructure/extractor/discovery_extractor.py\
\
class DiscoveryExtractor:\
    def __init__(self, repository, manager):\
        self.repository = repository\
        self.manager = manager\
\
    def extract(self, doc) -> List[Any]:\
        discoveries = []\
        for token in doc:\
            if self._is_candidate(token):\
                # Factory-Aufruf f\'fcr Ebene 1 Innovationen\
                dto = self.manager.create_competence_dto(\
                    original_term=token.text,\
                    esco_label="Emergent Skill",\
                    esco_uri=f"discovery/\{token.text.lower()\}",\
                    level=1, # Festgelegt f\'fcr Discovery\
                    is_discovery=True,\
                    confidence_score=0.7\
                )\
                if dto: discoveries.append(dto)\
        return discoveries\
