\f3\b\fs28 \cf0 \strokec2 1. Korrektur f\'fcr 
\f4\fs30\fsmilli15210 \strokec2 V5__Add_Methodology_Fields.sql
\f3\fs28 \strokec2 \
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 \strokec2 \'c4ndere das Skript so ab, dass es vor dem Hinzuf\'fcgen pr\'fcft, ob die Spalten schon da sind. In PostgreSQL nutzt man daf\'fcr einen 
\f2\fs26 DO
\f1\fs24 -Block:\
\pard\pardeftab720\partightenfactor0
\cf0 \strokec2 SQL\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 \strokec2 -- V5__Add_Methodology_Fields.sql\
DO $$ \
BEGIN \
    -- Pr\'fcfe und f\'fcge 'level' hinzu\
    IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='competence' AND column_name='level') THEN\
        ALTER TABLE competence ADD COLUMN level INTEGER DEFAULT 2;\
    END IF;\
\
    -- Pr\'fcfe und f\'fcge 'source_domain' hinzu\
    IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='competence' AND column_name='source_domain') THEN\
        ALTER TABLE competence ADD COLUMN source_domain VARCHAR(255);\
    END IF;\
\
    -- Pr\'fcfe und f\'fcge 'role_context' hinzu\
    IF NOT EXISTS (SELECT 1 FROM information_schema.columns WHERE table_name='competence' AND column_name='role_context') THEN\
        ALTER TABLE competence ADD COLUMN role_context VARCHAR(255);\
    END IF;\
END $$;\
\
-- Indizes: 'CREATE INDEX IF NOT EXISTS' ist der Befehl f\'fcr "lass es da, wenn schon da"\
CREATE INDEX IF NOT EXISTS idx_competence_level ON competence(level);\
CREATE INDEX IF NOT EXISTS idx_competence_source ON competence(source_domain);\
\pard\pardeftab720\sa280\partightenfactor0

