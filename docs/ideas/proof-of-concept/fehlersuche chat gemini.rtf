\f2\fs26 \cf0 \strokec2 from pydantic import BaseModel, Field, validator\
from typing import Optional\
\
class CompetenceDTO(BaseModel):\
    original_term: str\
    esco_label: str\
    esco_uri: str\
    confidence_score: float = Field(default=0.0, ge=0.0, le=1.0)\
    level: int = Field(default=2, ge=1, le=5) # Erzwingt Ebene 1-5\
    is_digital: bool = False\
    is_discovery: bool = False\
    source_domain: Optional[str] = "Stellenanzeige"\
    role_context: Optional[str] = None\
\
    @validator('level', pre=True)\
    def validate_level(cls, v):\
        # Zentrale Logik: Verhindert String-Level Fehler f\'fcr Kotlin\
        if isinstance(v, str):\
            digits = ''.join(filter(str.isdigit, v))\
            return int(digits) if digits else 2\
        return v\
