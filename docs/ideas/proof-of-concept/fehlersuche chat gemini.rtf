\f2\fs26 \cf0 \strokec2 import re\
import os\
from typing import Dict, Optional\
from pathlib import Path\
\
class MetadataExtractor:\
    """\
    Wissenschaftlicher Metadaten-Extraktor (Ebene 6 & Kontext).\
    Kombiniert Segmentierung mit automatischer Level-Erkennung (4/5).\
    """\
\
    def __init__(self):\
        # 1. Branchen-Muster (MVP-Vorauswahl)\
        self.category_patterns = \{\
            "IT & Softwareentwicklung": r"(entwickler|developer|programmier|software|it|informatik|cloud)",\
            "UX/UI Design": r"(ux\\s?design|ui\\s?design|user\\s?experience|designer|grafik)",\
            "Assistenz & Office": r"(assistenz|sekretariat|b\'fcro|office|sachbearbeiter)"\
        \}\
\
        # 2. DIE GIERIGEN SEKTIONS-MUSTER (Deine verbesserten Regex)\
        # Wir nutzen re.DOTALL, um \'fcber Zeilenumbr\'fcche hinweg zu lesen.\
        self.TASK_PATTERN = re.compile(\
            r'(?:DEINE AUFGABEN|T\'c4TIGKEITEN|WAS DU BEI UNS MACHST|YOUR TASKS|RESPONSIBILITIES|TASKS|WHAT YOU WILL DO)[\\s\\r\\n:.-]+(.*?)(?=(?:DEIN PROFIL|PROFIL|REQUIREMENTS|WIR BIETEN|WIR SUCHEN|BENEFITS|ABOUT US|$))',\
            re.DOTALL | re.IGNORECASE)\
\
        self.REQ_PATTERN = re.compile(\
            r'(?:PROFIL|DEIN PROFIL|YOUR PROFILE|ANFORDERUNGEN|REQUIREMENTS|QUALIFICATIONS|VORAUSSETZUNGEN|SKILLSET)[\\s\\r\\n:.-]+(.*?)(?=(?:DEINE AUFGABEN|TASKS|WIR BIETEN|WIR SUCHEN|BENEFITS|KONTAKT|$))',\
            re.DOTALL | re.IGNORECASE)\
\
    def extract_all(self, text: str, filename: str, filepath: str = "") -> Dict:\
        """\
        Zentraler Einstiegspunkt f\'fcr die Extraktion.\
        """\
        # A. Sektions-Matching\
        tasks_match = self.TASK_PATTERN.search(text)\
        reqs_match = self.REQ_PATTERN.search(text)\
\
        # Segmente zusammenf\'fchren\
        processing_text = ""\
        if tasks_match: processing_text += tasks_match.group(1).strip()\
        if reqs_match: processing_text += " " + reqs_match.group(1).strip()\
\
        # B. Automatische Level-Inferenz (Wichtig f\'fcr Ebene 4 & 5)\
        inferred_level, source_domain = self._infer_level_from_path(filepath, filename)\
\
        # C. Ergebnis-Mapping\
        is_segmented = len(processing_text) > 50 # Mindestl\'e4nge f\'fcr valide Segmente\
\
        return \{\
            "job_title": self._extract_title(text, filename),\
            "organization": self._extract_organization(text),\
            "location": "Unbekannt",\
            "posting_date": "2024-01-01", # Sollte durch normalize.parse_date ersetzt werden\
            "is_segmented": is_segmented,\
            "processing_text": processing_text if is_segmented else text,\
            "inferred_level": inferred_level,\
            "source_domain": source_domain,\
            "job_category": self._determine_category(text)\
        \}\
\
    def _infer_level_from_path(self, filepath: str, filename: str) -> tuple:\
        """\
        Erkennt automatisch die wissenschaftliche Ebene anhand der Ordnerstruktur.\
        """\
        path_lower = filepath.lower()\
        if "fachbuecher" in path_lower:\
            return 4, f"Fachbuch: \{filename\}"\
        elif "modulhandbuecher" in path_lower:\
            return 5, f"Academia: \{filename\}"\
        return 2, "Stellenanzeige"\
\
    def _extract_title(self, text: str, filename: str) -> str:\
        lines = [l.strip() for l in text.split('\\n') if l.strip()]\
        if lines:\
            title = lines[0]\
            # Bereinigung (m/w/d) etc.\
            title = re.sub(r'\\(m/w/d\\)|\\[all genders\\]|\\|.*', '', title, flags=re.IGNORECASE).strip()\
            return title if len(title) > 5 else filename\
        return filename\
\
    def _extract_organization(self, text: str) -> str:\
        match = re.search(r'([A-Z][a-z\'e4\'f6\'fc\'df]+\\s(AG|GmbH|Group|KG))', text[:1000])\
        return match.group(0) if match else "Unbekannte Firma"\
\
    def _determine_category(self, text: str) -> str:\
        text_low = text.lower()\
        for cat, pattern in self.category_patterns.items():\
            if re.search(pattern, text_low):\
                return cat\
        return "Sonstige"\
