\f2\fs26 \cf0 \strokec2 # main.py\
from fastapi import FastAPI, UploadFile, File, Depends\
from app.infrastructure.repositories.hybrid_competence_repository import HybridCompetenceRepository\
from app.infrastructure.extractor.competence_extractor import CompetenceExtractor\
from app.infrastructure.extractor.spacy_extractor import SpaCyCompetenceExtractor\
from app.infrastructure.extractor.fuzzy_competence_extractor import FuzzyCompetenceExtractor\
from app.infrastructure.extractor.discovery_extractor import DiscoveryExtractor\
from app.application.job_mining_workflow_manager import JobMiningWorkflowManager\
# ... (andere Importe)\
\
app = FastAPI(title="Job Mining System v2")\
\
# 1. Infrastruktur initialisieren (SSoT)\
# Das Repository l\'e4dt die 31.655 ESCO-Labels + deine Fachbuch-JSONs\
repo = HybridCompetenceRepository(kotlin_api_url="http://localhost:8080")\
repo.sync_from_ssot()\
repo.load_local_domains()\
\
# 2. Die 3 Spezialisten konfigurieren\
spacy_mod = SpaCyCompetenceExtractor(repo)\
fuzzy_mod = FuzzyCompetenceExtractor(repo, threshold=92) # Strenges Fuzzy-Matching\
disco_mod = DiscoveryExtractor(repo)\
\
# 3. Der Chef-Extractor (Multi-Pass-Orchestrator)\
# Er kombiniert die Ergebnisse und sorgt f\'fcr saubere Level (Integer!)\
chef_extractor = CompetenceExtractor(\
    spacy_ext=spacy_mod, \
    fuzzy_ext=fuzzy_mod, \
    discovery_ext=disco_mod\
)\
\
# 4. Workflow Manager zusammenbauen\
manager = JobMiningWorkflowManager(\
    text_extractor=AdvancedTextExtractor(),\
    competence_extractor=chef_extractor, # Hier wird die Pipeline injiziert\
    organization_service=OrganizationService(rule_client=RuleClient()),\
    role_service=RoleService(rule_client=RuleClient()),\
    metadata_extractor=MetadataExtractor() # Inklusive Sektionstrennung\
)\
\
@app.post("/analyse")\
async def analyse_file(file: UploadFile = File(...)):\
    # Der Manager nutzt jetzt automatisch:\
    # Schritt 1: Text lesen\
    # Schritt 2: Segmente finden (Ebene 6)\
    # Schritt 3: Nur in Segmenten nach Skills suchen (Multi-Pass)\
    # Schritt 4: Level 1, 2, 4 oder 5 zuweisen\
    return manager.run_full_analysis(file.file, file.filename)\
