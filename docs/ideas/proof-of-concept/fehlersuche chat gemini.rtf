\f2\fs26 \cf0 \strokec2 // de.layher.jobmining.kotlinapi.services.JobMiningService.kt\
\
@Transactional\
fun processJobAd(fileContent: ByteArray, filename: String): JobPosting \{\
    val resultDto = pythonClient.sendDocumentForAnalysis(fileContent, filename)\
\
    // 1. Idempotenz-Check (Ebene 7)\
    val existingJob = repository.findByRawTextHash(resultDto.rawTextHash).firstOrNull()\
    if (existingJob != null) return existingJob\
\
    // 2. JobPosting Objekt erstellen (mit allen neuen Feldern)\
    val jobPosting = JobPosting(\
        title = resultDto.title,\
        jobRole = resultDto.jobRole,\
        rawTextHash = resultDto.rawTextHash,\
        rawText = resultDto.rawText,\
        postingDate = java.time.LocalDate.parse(resultDto.postingDate),\
        region = resultDto.region,\
        industry = resultDto.industry.take(255),\
        isSegmented = resultDto.is_segmented // Wichtig: Feldname aus Python-DTO beachten!\
    )\
\
    // 3. Kompetenzen mappen und dabei die fehlenden Parameter bedienen\
    val competences = resultDto.competences.map \{ dto ->\
        de.layher.jobmining.kotlinapi.domain.Competence(\
            escoLabel = dto.escoLabel,      // Aus AnalysisResultDTO\
            escoUri = dto.escoUri,          // Aus AnalysisResultDTO\
            originalTerm = dto.originalTerm,\
            confidenceScore = dto.confidenceScore,\
            level = dto.level,               // Ebene 1, 2, 4 oder 5\
            sourceDomain = dto.sourceDomain ?: "Stellenanzeige",\
            roleContext = resultDto.jobRole  // Der Kontext aus dem MetadataExtractor\
        ).apply \{ this.jobPosting = jobPosting \}\
    \}\
\
    jobPosting.competences = competences\
    return repository.save(jobPosting)\
\}\
