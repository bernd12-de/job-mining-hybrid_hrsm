\f2\fs26 \cf0 \strokec2 @Repository\
class EscoDataRepository(\
    private val ioService: IOService,\
    @Value("\\$\{app.esco.data-path:./data/esco\}") private val escoFolderPath: String\
) \{\
    private val skillMap = ConcurrentHashMap<String, EscoSkill>()\
\
    @PostConstruct\
    fun init() \{\
        val totalLoaded = loadAllFromFolder()\
        // Wissenschaftlicher Schwellenwert: 31k ist das Ziel, 10k die absolute Untergrenze\
        if (totalLoaded < 10000) \{\
            throw IllegalStateException("DATENVERLUST: Nur $totalLoaded Labels geladen. Checke CSV-Spalten!")\
        \}\
        println("
\f8 \uc0\u9989 
\f2  ESCO-Basis stabil: $totalLoaded aktive Labels/Synonyme geladen.")\
    \}\
\
    fun loadAllFromFolder(): Int \{\
        var totalLoadedCount = 0\
        val folder = File(escoFolderPath)\
        if (!folder.exists()) return 0\
\
        folder.listFiles \{ f -> f.extension == "csv" && !f.name.contains("occupation") \}?.forEach \{ file ->\
            file.bufferedReader().useLines \{ lines ->\
                lines.drop(1).forEach \{ line ->\
                    val cols = line.split(",") // ESCO Standard ist meist Komma\
                    if (cols.size >= 6) \{\
                        val uri = cols[1].replace("\\"", "").trim()\
                        val prefLabel = cols[4].replace("\\"", "").trim()\
                        val altLabelsRaw = cols[5].replace("\\"", "").trim()\
\
                        // Erstelle Liste aller Begriffe f\'fcr diese URI\
                        val allTerms = mutableListOf(prefLabel)\
                        if (altLabelsRaw.isNotEmpty()) \{\
                            // Splittet Synonyme wie "UX | User Experience" auf\
                            allTerms.addAll(altLabelsRaw.split("|").map \{ it.trim() \})\
                        \}\
\
                        allTerms.forEach \{ term ->\
                            val key = term.lowercase()\
                            // Dein S-Killer Fix + Mindestl\'e4nge\
                            if (term.length >= 3 || key in listOf("ux", "ui", "it", "ki")) \{\
                                if (!skillMap.containsKey(key)) \{\
                                    skillMap[key] = EscoSkill(\
                                        uri = uri,\
                                        preferredLabel = prefLabel,\
                                        altLabels = emptyList() // intern flach gespeichert\
                                    )\
                                    totalLoadedCount++\
                                \}\
                            \}\
                        \}\
                    \}\
                \}\
            \}\
        \}\
        return totalLoadedCount\
    \}\
    // ... restliche Methoden\
\}\
