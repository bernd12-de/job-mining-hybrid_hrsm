import hashlib\
import logging\
from typing import BinaryIO, List\
from pathlib import Path\
\
from app.interfaces.interfaces import (\
    IJobMiningWorkflowManager,\
    ITextExtractor,\
    ICompetenceExtractor\
)\
from app.application.services.organization_service import OrganizationService\
from app.application.services.role_service import RoleService\
from app.infrastructure.extractor.metadata_extractor import MetadataExtractor\
from app.domain.models import AnalysisResultDTO\
\
logger = logging.getLogger(__name__)\
\
class JobMiningWorkflowManager(IJobMiningWorkflowManager):\
    """Orchestriert den Analyse-Prozess f\'fcr die Masterarbeit (Ebenen 1-7)."""\
\
    def __init__(self,\
                 text_extractor: ITextExtractor,\
                 competence_extractor: ICompetenceExtractor,\
                 organization_service: OrganizationService,\
                 role_service: RoleService):\
        self.text_extractor = text_extractor\
        self.competence_extractor = competence_extractor\
        self.organization_service = organization_service\
        self.role_service = role_service\
        self.meta_extractor = MetadataExtractor()\
\
    def run_full_analysis(self, file_stream: BinaryIO, filename: str) -> AnalysisResultDTO:\
        """Standard-Workflow f\'fcr einzelne Datei-Uploads."""\
        # 1. Text extrahieren\
        raw_text = self.text_extractor.extract_text(file_stream, filename)\
        \
        # 2. Bereinigung (Steuerzeichen entfernen)\
        cleaned_text = raw_text.replace('\\x00', '')\
        \
        return self._run_analysis_from_text(cleaned_text, filename)\
\
    def _run_analysis_from_text(self, text: str, source_name: str) -> AnalysisResultDTO:\
        """Kern-Logik der Analyse-Pipeline."""\
        \
        # 1. Idempotenz-Schutz (Ebene 7)\
        raw_text_hash = hashlib.sha256(text.encode('utf-8')).hexdigest()\
\
        # 2. Kontext-Extraktion\
        # Extrahiere Titel, Firma, Ort und Datum\
        metadata = self.meta_extractor.extract_all(text, source_name)\
        \
        # Klassifiziere Branche und Rolle \'fcber die SSoT-Services (Kotlin Rules)\
        industry = self.organization_service.classify_industry(text)\
        job_role = self.role_service.classify_role(text, metadata.get('job_title', ''))\
\
        # 3. Kompetenz-Extraktion (Die 7 Ebenen)\
        # Hier werden Ebenen 1 (Discovery), 2 (ESCO), 4 (Buch) und 5 (Uni) bestimmt\
        competences = self.competence_extractor.extract_competences(text, job_role)\
\
        # 4. Ergebnis-DTO erstellen\
        # WICHTIG: Felder m\'fcssen exakt zum Kotlin AnalysisResultDTO passen\
        return AnalysisResultDTO(\
            title=metadata.get('job_title', 'Unbekannt'),\
            job_role=job_role,\
            region=metadata.get('location', 'Unbekannt'),\
            industry=industry,\
            posting_date=metadata.get('posting_date', '2024-01-01'),\
            raw_text_hash=raw_text_hash,\
            raw_text=text,\
            is_segmented=metadata.get('is_segmented', False),\
            competences=competences\
        )\
\
    def run_analysis_from_scraped_text(self, cleaned_text: str, source_name: str) -> AnalysisResultDTO:\
        """Verarbeitet Text von Web-URLs."""\
        return self._run_analysis_from_text(cleaned_text, source_name)\
\
    def process_local_directory(self, directory_path: str = "data/jobs") -> List[AnalysisResultDTO]:\
        """Batch-Verarbeitung f\'fcr die Zeitreihenanalyse."""\
        results = []\
        job_dir = Path(directory_path)\
\
        if not job_dir.exists():\
            logger.error(f"Pfad nicht gefunden: \{job_dir.absolute()\}")\
            return []\
\
        files = list(job_dir.glob("*.*"))\
        print(f"
\f8 \uc0\u55357 \u56960 
\f2  Batch: Starte Analyse von \{len(files)\} Dokumenten...")\
\
        for file_path in files:\
            if file_path.suffix.lower() in ['.pdf', '.docx', '.txt']:\
                try:\
                    with open(file_path, "rb") as f:\
                        analysis = self.run_full_analysis(f, file_path.name)\
                        results.append(analysis)\
                except Exception as e:\
                    logger.error(f"Fehler bei \{file_path.name\}: \{e\}")\
                    \
        return results\
