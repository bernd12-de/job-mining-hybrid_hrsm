\f2\fs26 \cf0 \strokec2 @Transactional\
fun processAndSave(jobId: Long, text: String) \{\
    val job = jobRepo.findById(jobId).orElseThrow()\
\
    // 1. Extraktion via Python\
    val analysisResult = pythonBridge.analyzeFull(text.toByteArray(), "scan.txt")\
\
    // 2. Transformation mit Logik-Funktionen\
    val newCompetences = analysisResult.competences.map \{ dto ->\
        \
        // HILFSFUNKTION A: Digital-Status aus SSoT abgleichen\
        val isDigitalFromRepo = escoRepo.getSkillByLabel(dto.escoLabel)?.isDigital ?: dto.isDigital\
\
        // HILFSFUNKTION B: Validierung der Discovery (Ebene 1)\
        // Wenn der Begriff in der Blacklist ist, stufen wir ihn herab\
        val finalLevel = if (dto.level == 1 && isOnBlacklist(dto.originalTerm)) 0 else dto.level\
\
        Competence(\
            originalTerm = dto.originalTerm,\
            escoLabel = dto.escoLabel,\
            escoUri = dto.escoUri,\
            confidenceScore = dto.confidenceScore,\
            level = finalLevel,               \
            sourceDomain = dto.sourceDomain ?: "Hybrid-Analysis",\
            isDigital = isDigitalFromRepo,\
            isDiscovery = (finalLevel == 1),\
            roleContext = analysisResult.jobRole, \
            jobPosting = job\
        )\
    \}.filter \{ it.level > 0 \} // Filtert ung\'fcltige "M\'fcll-Skills" aus\
\
    competenceRepo.saveAll(newCompetences)\
    \
    // Update des Job-Status\
    job.isSegmented = analysisResult.isSegmented\
    job.jobRole = analysisResult.jobRole\
    jobRepo.save(job)\
\}\
\
// Die Hilfsfunktion f\'fcr die Blacklist\
private fun isOnBlacklist(term: String): Boolean \{\
    val blacklist = listOf("aufgaben", "anforderungen", "kenntnisse", "bereich", "sowie")\
    return blacklist.contains(term.lowercase())\
\}\
\pard\pardeftab720\sa280\partightenfactor0

