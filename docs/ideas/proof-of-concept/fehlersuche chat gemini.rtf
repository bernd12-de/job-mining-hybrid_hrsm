import os\
import requests\
from pathlib import Path\
from app.application.job_mining_workflow_manager import JobMiningWorkflowManager\
\
def run_historical_analysis(base_path: str = "data/jobs"):\
    """\
    Durchl\'e4uft alle Jahresordner und sendet die Daten an das System.\
    Stellt die Basis f\'fcr die Trend-Diagramme in deiner Arbeit dar.\
    """\
    root_dir = Path(base_path)\
    \
    # Sortiert nach Jahren (2011, 2012... 2024)\
    year_folders = sorted([f for f in root_dir.iterdir() if f.is_dir()])\
\
    for year_folder in year_folders:\
        year = year_folder.name\
        print(f"
\f8 \uc0\u55357 \u56517 
\f2  Verarbeite Jahr: \{year\}")\
        \
        for file_path in year_folder.glob("*.*"):\
            if file_path.suffix.lower() in [".pdf", ".docx"]:\
                try:\
                    # Wir simulieren den Upload an unseren eigenen Manager\
                    # Wichtig: Wir geben das Jahr als Metadatum mit!\
                    with open(file_path, "rb") as f:\
                        # Hier rufen wir den Manager auf, den wir zuvor gebaut haben\
                        # Er setzt automatisch das posting_date auf den 01.01.\{year\}\
                        result = manager.run_full_analysis(f, file_path.name, str(file_path))\
                        \
                        # Sende das Ergebnis an das Kotlin-Backend zum Speichern\
                        save_to_kotlin(result)\
                        print(f"  
\f8 \uc0\u9989 
\f2  \{file_path.name\} analysiert.")\
                except Exception as e:\
                    print(f"  
\f8 \uc0\u10060 
\f2  Fehler bei \{file_path.name\}: \{e\}")\
\
def save_to_kotlin(dto):\
    """Sendet das Analyseergebnis an die Datenbank-Schnittstelle."""\
    url = "http://localhost:8080/api/v1/jobs/save-analysis"\
    requests.post(url, json=dto.dict())\
\
if __name__ == "__main__":\
    run_historical_analysis()\
