import spacy\
from typing import List\
from app.interfaces.interfaces import ICompetenceExtractor\
from app.domain.models import CompetenceDTO\
\
class DiscoveryExtractor(ICompetenceExtractor):\
    """\
    Pass 3: Identifiziert Begriffe, die in keiner Wissensbasis (SSoT) existieren.\
    Wichtig f\'fcr die Identifikation von technologischen Innovationen (Ebene 1).\
    """\
\
    def __init__(self, repository, nlp_model=None):\
        self.repo = repository\
        self.nlp = nlp_model or spacy.load("de_core_news_md")\
        # Wir laden die Blacklist direkt aus dem SSoT (Kotlin)\
        self.blacklist = set(self.repo.get_blacklist())\
\
    def extract(self, doc) -> List[CompetenceDTO]:\
        discovery_skills = []\
        \
        # Wir suchen nach Nomen (NOUN) und Eigennamen (PROPN)\
        for chunk in doc.noun_chunks:\
            term = chunk.root.text.strip()\
            term_low = term.lower()\
\
            # Filter-Logik f\'fcr Ebene 1:\
            # 1. Nicht in der Blacklist\
            # 2. Nicht bereits in ESCO/Fachb\'fcchern (SSoT-Check)\
            # 3. Mindestl\'e4nge 4 Zeichen\
            if (term_low not in self.blacklist and \
                not self.repo.exists_in_ssot(term_low) and \
                len(term_low) > 3):\
                \
                discovery_skills.append(CompetenceDTO(\
                    original_term=term,\
                    esco_label=f"Discovery: \{term\}",\
                    esco_uri=f"discovery://\{term_low\}",\
                    confidence_score=0.7, # Niedriger, da unvalidiert\
                    level=1,              # Eindeutig Ebene 1\
                    is_discovery=True,\
                    source_domain="Innovation-Detection"\
                ))\
        \
        return discovery_skills\
