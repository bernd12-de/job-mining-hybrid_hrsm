\f2\fs26 \strokec2 import spacy\
from spacy.util import is_package\
import spacy.cli  # Wichtig f\'fcr den automatischen Download\
from spacy.matcher import PhraseMatcher\
from typing import List, Any\
\
class SpaCyCompetenceExtractor:\
    def __init__(self, repository, manager, nlp_model=None):\
        MODEL_NAME = "de_core_news_md"\
        \
        # Sicherheits-Check mit automatischem Install-Versuch\
        if nlp_model is None:\
            if not is_package(MODEL_NAME):\
                print(f"
\f8 \uc0\u9888 \u65039 
\f2  spaCy-Modell '\{MODEL_NAME\}' fehlt. Starte automatischen Download...")\
                try:\
                    spacy.cli.download(MODEL_NAME)\
                    print(f"
\f8 \uc0\u9989 
\f2  Modell '\{MODEL_NAME\}' erfolgreich installiert.")\
                except Exception as e:\
                    raise RuntimeError(\
                        f"
\f8 \uc0\u55357 \u57000 
\f2  Automatischer Download von '\{MODEL_NAME\}' fehlgeschlagen: \{e\}\\n"\
                        f"Bitte manuell ausf\'fchren: python -m spacy download \{MODEL_NAME\}"\
                    )\
            \
            # Modell laden\
            self.nlp = spacy.load(MODEL_NAME)\
        else:\
            self.nlp = nlp_model\
\
        self.repository = repository\
        self.manager = manager\
        self.matcher = PhraseMatcher(self.nlp.vocab, attr="LOWER")\
        # ... Rest der Initialisierung\
