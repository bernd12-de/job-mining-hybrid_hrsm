\f2\fs26 \cf0 \strokec2 // In DomainRuleService.kt\
fun getKnowledgeBaseStats(): Map<String, Any> \{\
    val allSkills = escoDataRepository.findAllLoadedSkills()\
    return mapOf(\
        "total_labels" to allSkills.size,\
        "digital_skills_count" to allSkills.count \{ it.isDigital \},\
        "distinct_uris" to allSkills.map \{ it.uri \}.distinct().size,\
        "coverage_ratio" to (allSkills.size.toDouble() / 31655.0) // Deine Zielmarke\
    )\
\}\
