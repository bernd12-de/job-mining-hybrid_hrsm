        return re.sub(r'\\(m/w/d\\)|\\|.*', '', lines[0]).strip() if lines else filename\
\
    def _extract_category(self, text: str) -> str:\
        for cat, pat in self.category_patterns.items():\
            if re.search(pat, text, re.I): return cat\
        return "Sonstige"\
\
    def _extract_location(self, text: str) -> str:\
        match = re.search(self.location_patterns, text, re.I)\
        return match.group(0).capitalize() if match else "Deutschland"\
\
    def _extract_org(self, text: str) -> str:\
        match = re.search(r'([A-Z][a-z\'e4\'f6\'fc\'df]+\\s(AG|GmbH|Group|KG))', text[:800])\
        return match.group(0) if match else "Unbekannt"\
\pard\pardeftab720\sa280\partightenfactor0

