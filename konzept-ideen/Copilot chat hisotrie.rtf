"""\
JsonAliasRepository - Speichert ESCO-Alias-Mappings\
Erweitert den HybridCompetenceRepository um vollst\'e4ndige Metadaten\
"""\
import json\
from pathlib import Path\
from typing import Dict, List, Tuple, Optional\
\
class JsonAliasRepository:\
    """\
    Stellt die Datenbasis (W\'f6rterb\'fccher/Aliase) f\'fcr das ESCO-Mapping bereit.\
    Liefert vollst\'e4ndige Metadaten: (ID, Label, Domain)\
    """\
    \
    def __init__(self, data_path: Path = Path("data/competences")):\
        self._data_path = data_path\
        \
        # \uc0\u9989  FIX: Speichert vollst\'e4ndige Metadaten statt nur Labels\
        # Format: \{alias_lowercase: (esco_id, esco_label, domain)\}\
        self._alias_metadata_map: Dict[str, Tuple[str, str, str]] = \{\}\
        \
        # Umgekehrter Index f\'fcr schnelle Label-Suche\
        self.all_alias_terms: Dict[str, str] = \{\}\
        \
        self._load_aliases()\
    \
    def _load_json_file(self, filename: str) -> Dict[str, Any]:\
        """L\'e4dt eine einzelne JSON-Datei mit Aliasen."""\
        file_path = self._data_path / filename\
        if file_path.exists():\
            print(f"   [REPO] Lade Aliase aus \{filename\}...")\
            try:\
                with open(file_path, 'r', encoding='utf-8') as f:\
                    return json.load(f)\
            except json.JSONDecodeError as e:\
                print(f"   [FEHLER] JSON-Fehler in \{filename\}: \{e\}")\
                return \{\}\
        else:\
            print(f"   [WARN] Datei \{filename\} nicht gefunden in \{self._data_path\}.")\
            return \{\}\
    \
    def _load_aliases(self):\
        """L\'e4dt alle Alias-Dateien (ESCO und Custom) und konsolidiert sie."""\
        \
        # ESCO-Daten laden\
        esco_data: Dict[str, List] = self._load_json_file("esco_aliases.json")\
        custom_data: Dict[str, List] = self._load_json_file("custom_skills_aliases.json")\
        \
        all_data = \{\}\
        all_data.update(esco_data)\
        all_data.update(custom_data)\
        \
        # Metadaten-Map erstellen\
        for alias, metadata_list in all_data.items():\
            if len(metadata_list) == 3:\
                # Format: [ID, Label, Domain]\
                esco_id, label, domain = metadata_list[0], metadata_list[1], metadata_list[2]\
                \
                # \uc0\u9989  FIX: Speicherung der vollst\'e4ndigen Metadaten\
                self._alias_metadata_map[alias.lower()] = (esco_id, label, domain)\
                \
                # Umgekehrter Index\
                self.all_alias_terms[alias.lower()] = label\
        \
        print(f"   [REPO] Alias-Laden abgeschlossen. \{len(self._alias_metadata_map)\} offizielle Skills geladen.")\
    \
    # \uc0\u9989  FIX: Implementiert die vollst\'e4ndige Schnittstelle\
    def get_all_aliases(self) -> Dict[str, Tuple[str, str, str]]:\
        """\
        Gibt das vollst\'e4ndige Alias-Mapping zur\'fcck:\
        \{ Alias (lowercase): (ESCO_ID, ESCO_LABEL, ESCO_DOMAIN) \}\
        \
        \uc0\u9989  Dies ist die vom Service erwartete Schnittstelle!\
        """\
        return self._alias_metadata_map\
    \
    def get_all_alias_terms(self) -> Dict[str, str]:\
        """Gibt nur den Label-Index zur\'fcck (f\'fcr einfache Suche)."""\
        return self.all_alias_terms\
    \
    def get_official_name(self, alias: str) -> Optional[str]:\
        """Gibt den offiziellen ESCO-Label f\'fcr einen Alias zur\'fcck."""\
        return self.all_alias_terms.get(alias.lower())\
\
