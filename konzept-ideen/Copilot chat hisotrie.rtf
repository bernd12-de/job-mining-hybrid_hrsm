import os, asyncio, json\
from pathlib import Path\
from app.infrastructure.clients.kotlin_rule_client import KotlinRuleClient\
from app.infrastructure.repositories.hybrid_competence_repository import HybridCompetenceRepository\
from app.infrastructure.extractor.advanced_text_extractor import AdvancedTextExtractor\
from app.infrastructure.extractor.spacy_competence_extractor import SpaCyCompetenceExtractor\
from app.infrastructure.extractor.metadata_extractor import MetadataExtractor\
from app.application.services.organization_service import OrganizationService\
from app.application.services.role_service import RoleService\
from app.application.job_mining_workflow_manager import JobMiningWorkflowManager\
\
BASE = Path('data/jobs')\
EXPORT_DIR = Path('data/exports/batch_results')\
EXPORT_DIR.mkdir(parents=True, exist_ok=True)\
\
# Setup components\
rule_client = KotlinRuleClient()\
repo = HybridCompetenceRepository(rule_client=rule_client)\
text_ext = AdvancedTextExtractor()\
meta_ext = MetadataExtractor()\
org = OrganizationService(rule_client=rule_client)\
try:\
    role = RoleService(rule_client=rule_client)\
except TypeError:\
    role = RoleService()\
comp_ext = SpaCyCompetenceExtractor(repository=repo)\
manager = JobMiningWorkflowManager(text_extractor=text_ext, competence_extractor=comp_ext, organization_service=org, role_service=role, metadata_extractor=meta_ext)\
\
files = [p for p in BASE.iterdir() if p.suffix.lower() in ('.pdf', '.docx', '.txt', '.csv')]\
summary = \{\
    'files_total': len(files),\
    'processed': 0,\
    'skills_total': 0,\
    'unique_skills': set(),\
    'per_file': []\
\}\
\
async def process_file(p: Path):\
    try:\
        with open(p, 'rb') as f:\
            res = await manager.run_full_analysis(f, p.name)\
            return res\
    except Exception as e:\
        return \{'error': str(e), 'filename': p.name\}\
\
async def run_all():\
    for p in files:\
        print('Processing', p.name)\
        res = await process_file(p)\
        if isinstance(res, dict) and res.get('error'):\
            print('  ERROR:', res['error'])\
            summary['per_file'].append(\{'filename': p.name, 'error': res['error']\})\
            continue\
        if res is None:\
            print('  No result')\
            summary['per_file'].append(\{'filename': p.name, 'error': 'no_result'\})\
            continue\
        # Convert pydantic model to dict\
        d = res.model_dump() if hasattr(res, 'model_dump') else res.dict()\
        # Count skills\
        num_skills = len(d.get('competences', []))\
        summary['processed'] += 1\
        summary['skills_total'] += num_skills\
        for c in d.get('competences', []):\
            summary['unique_skills'].add(c.get('esco_label') or c.get('original_term'))\
        summary['per_file'].append(\{\
            'filename': p.name,\
            'title': d.get('title'),\
            'job_role': d.get('job_role'),\
            'industry': d.get('industry'),\
            'region': d.get('region'),\
            'posting_date': d.get('posting_date'),\
            'is_segmented': d.get('is_segmented'),\
            'num_competences': num_skills,\
            'competences_sample': d.get('competences')[:5]\
        \})\
        # Save full JSON\
        outp = EXPORT_DIR / (p.stem + '.json')\
        with open(outp, 'w', encoding='utf-8') as out:\
            json.dump(d, out, ensure_ascii=False, indent=2)\
\
\
asyncio.run(run_all())\
# Finalize summary\
summary_out = \{k:(list(v) if isinstance(v,set) else v) for k,v in summary.items()\}\
summary_out['unique_skills_count'] = len(summary['unique_skills'])\
with open(EXPORT_DIR / 'summary.json', 'w', encoding='utf-8') as s:\
    json.dump(summary_out, s, ensure_ascii=False, indent=2)\
print('BATCH DONE. Summary written to', EXPORT_DIR / 'summary.json')\
