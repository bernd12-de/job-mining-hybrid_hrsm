"""\
SpaCyCompetenceExtractor - Nutzt spaCy f\'fcr NLP + JsonAliasRepository f\'fcr Mapping\
Erweiterte Version mit N-Gramm-Matching (1-3 W\'f6rter)\
"""\
import spacy\
from typing import List\
from app.domain.models import Competence\
from app.infrastructure.data.json_alias_repository import JsonAliasRepository\
import re\
import logging\
\
logger = logging.getLogger(__name__)\
\
# Sprachmodell laden (nur einmal!)\
try:\
    NLP = spacy.load("de_core_news_sm")\
except OSError:\
    logger.error("Das SpaCy-Modell 'de_core_news_sm' wurde nicht gefunden. Bitte installieren.")\
    NLP = None\
\
class SpaCyCompetenceExtractor:\
    """\
    Erweiterter Extractor, der SpaCy f\'fcr die Tokenisierung und ein\
    pr\'e4zises W\'f6rterbuch-Matching (N-Gramm-Suche) nutzt.\
    """\
    \
    def __init__(self, alias_repository: JsonAliasRepository):\
        if NLP is None:\
            raise ImportError("SpaCyCompetenceExtractor konnte nicht initialisiert werden.")\
        \
        self.alias_repo = alias_repository\
        self._aliases_map = self.alias_repo.get_all_aliases()\
        \
        logger.info(f"   [SPACY EXTRACTOR] Bereit mit \{len(self._aliases_map)\} Aliasen.")\
    \
    def extract_competences(self, job_text: str, role: str = None) -> List[Competence]:\
        """\
        Extrahiert Kompetenzen aus dem Rohtext mithilfe von SpaCy-Tokens\
        und N-Grammen (1-3 W\'f6rter).\
        """\
        doc = NLP(job_text[:100000])  # Text-Limit wie im alten Code\
        found_competences: List[Competence] = []\
        matched_spans = set()\
        \
        # 1\uc0\u65039 \u8419  N-Gramm/Phrase Matching (3-Gramme bis 1-Gramm)\
        for n in [3, 2, 1]:\
            for i in range(len(doc) - n + 1):\
                if i in matched_spans: \
                    continue\
                \
                # Baue n-Gramm\
                span = doc[i:i+n]\
                span_text = re.sub(r'\\s+', ' ', span.text.lower()).strip()\
                \
                # \uc0\u9989  Pr\'fcfe gegen Alias-Map\
                if span_text in self._aliases_map:\
                    alias_key = span_text\
                    esco_id, label, domain = self._aliases_map[alias_key]\
                    \
                    found_competences.append(\
                        Competence(\
                            id=esco_id,\
                            label=label,\
                            domain=domain,\
                            confidence=1.0,\
                            source_match=alias_key,\
                            role_context=role\
                        )\
                    )\
                    \
                    # Markiere alle Tokens dieser Phrase als "gematcht"\
                    for j in range(i, i + n):\
                        matched_spans.add(j)\
        \
        # 2\uc0\u65039 \u8419  Duplikate entfernen (nach ID)\
        unique_competences = list(\{c.id: c for c in found_competences\}.values())\
        \
        return unique_competences\
\
