import re\
\
class MetadataExtractor:\
    URL_PATTERN = re.compile(\
        r'(?:https?://|www\\.|[\\w-]+\\.(?:com|de|org|net|io|edu|gov))',\
        re.IGNORECASE\
    )\
    \
    def _extract_title(self, text: str, filename: str) -> str:\
        lines = text.split('\\n')\
        \
        # Suche in ersten 10 Zeilen (nicht nur erste!)\
        for line in lines[:10]:\
            if not line.strip():\
                continue\
            \
            title = re.sub(r'\\(m/w/d\\)|\\[all genders\\]|\\(gn\\)', '', line, flags=re.IGNORECASE).strip()\
            \
            # Skip URLs\
            if self.URL_PATTERN.search(title):\
                continue\
            \
            if len(title) > 5:\
                return title\
        \
        return "Stellenanzeige (Titel nicht erkannt)" if self.URL_PATTERN.search(filename) else filename\
\
