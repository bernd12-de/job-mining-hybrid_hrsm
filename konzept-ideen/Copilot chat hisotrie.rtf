def classify_industry(self, job_text: str) -> str:\
    """Mit Scoring statt First-Match."""\
    text_lower = job_text.lower()\
    scores = \{\}\
    \
    for industry, pattern in self.industry_mappings.items():\
        try:\
            matches = re.findall(pattern, text_lower, re.IGNORECASE)\
            if matches:\
                scores[industry] = len(matches)\
        except re.error:\
            continue\
    \
    if not scores:\
        return "Sonstiges"\
    \
    # H\'f6chster Score gewinnt\
    return max(scores, key=scores.get)\
