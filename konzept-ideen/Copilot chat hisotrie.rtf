def _is_valid_job_title(self, title: str) -> bool:\
    """Pr\'fcft ob ein String ein valider Jobtitel ist (keine URL, kein Garbage)."""\
    if not title or len(title) < 5:\
        return False\
    \
    # Check 1: URL-Pattern\
    if self.URL_PATTERN.search(title):\
        return False\
    \
    # Check 2: Zu viele Sonderzeichen (URLs, Paths)\
    special_chars = sum(c in title for c in '/?&=@#%')\
    if len(title) > 0 and (special_chars / len(title)) > 0.10:\
        return False\
    \
    # Check 3: Enth\'e4lt Protokoll oder www\
    if any(x in title.lower() for x in ['http://', 'https://', 'www.', '://']):\
        return False\
    \
    # Check 4: Endet mit Domain-Extension\
    if re.search(r'\\.(com|de|org|net|io|eu|ch|at|co\\.uk)(/|$)', title, re.IGNORECASE):\
        return False\
    \
    # Check 5: Zu viele Zahlen (IDs, Timestamps)\
    digit_ratio = sum(c.isdigit() for c in title) / len(title) if len(title) > 0 else 0\
    if digit_ratio > 0.30:  # Mehr als 30% Ziffern\
        return False\
    \
    # Check 6: Mindestens ein Buchstabe\
    if not any(c.isalpha() for c in title):\
        return False\
    \
    return True\
