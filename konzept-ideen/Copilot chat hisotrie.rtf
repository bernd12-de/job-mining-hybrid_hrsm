def _extract_title(self, text: str, filename: str) -> str:\
    """Extrahiert den Jobtitel aus der ersten Zeile oder nutzt den Dateinamen.\
    FILTERT URLs aus, um zu verhindern dass Links als Titel erkannt werden.\
    """\
    lines = text.split('\\n')\
    \
    # Durchsuche die ersten 10 Zeilen (nicht nur erste!)\
    for line in lines[:10]:\
        if not line.strip():\
            continue\
        \
        # Entferne Gender-Marker & Pipe-Symbole\
        title = re.sub(r'\\(m/w/d\\)|\\[all genders\\]|\\(gn\\)|\\|\\s?.*', '', line, flags=re.IGNORECASE).strip()\
        \
        # \uc0\u9989  NEU: URL-Check\
        if self.URL_PATTERN.search(title):\
            continue  # \'dcberspringe diese Zeile, sie ist eine URL\
        \
        # \uc0\u9989  NEU: Zus\'e4tzliche URL-Indikator-Checks\
        if any(indicator in title.lower() for indicator in ['http', 'www.', '.com/', '.de/', '://']):\
            continue\
        \
        # \uc0\u9989  NEU: \'dcberpr\'fcfe auf zu viele Sonderzeichen (URLs haben oft /, ?, &)\
        special_char_ratio = sum(c in title for c in '/?&=') / len(title) if len(title) > 0 else 0\
        if special_char_ratio > 0.15:  # Mehr als 15% Sonderzeichen\
            continue\
        \
        # Valide Titel m\'fcssen mindestens 5 Zeichen haben\
        if len(title) > 5:\
            return title\
    \
    # Fallback: Filename (auch hier URL-Check!)\
    clean_filename = filename.replace('.pdf', '').replace('.docx', '').replace('.txt', '')\
    if self.URL_PATTERN.search(clean_filename):\
        return "Stellenanzeige (Titel nicht erkannt)"\
    \
    return clean_filename\
