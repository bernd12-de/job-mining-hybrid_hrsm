        \cf9 \strokec9 return\cf2 \strokec2  \cf12 \strokec12 list\cf2 \strokec2 (self.esco_data.keys()) + \cf12 \strokec12 list\cf2 \strokec2 (self.custom_domains.keys())\
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 get_data_by_label\cf2 \strokec2 (self, label: \cf12 \strokec12 str\cf2 \strokec2 ) -> Optional[Dict[str, Any]]:\
        choices = \cf12 \strokec12 list\cf2 \strokec2 (self.esco_data.keys())\
