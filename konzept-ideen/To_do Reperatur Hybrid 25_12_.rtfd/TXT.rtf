\f8 \uc0\u9888 \u65039 
\f5  Warnung: Keine Daten vom RuleClient erhalten."\cf2 \strokec2 )\
\
        \cf3 \strokec3 # 3. Lokale Erweiterungen laden\cf2 \strokec2 \
        self._load_local_domains_v2()\
        \
        \cf3 \strokec3 # 4. Legacy Sets f\'fcllen\cf2 \strokec2 \
        self._sync_legacy_sets()\
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 _load_local_domains_v2\cf2 \strokec2 (self):\
        \cf10 \strokec10 """Liest data/job_domains und f\'fcllt custom_domains."""\cf2 \strokec2 \
        path = \cf10 \strokec10 "data/job_domains"\cf2 \strokec2 \
        \cf9 \strokec9 if\cf2 \strokec2  os.path.exists(path):\
            \cf9 \strokec9 for\cf2 \strokec2  f \cf9 \strokec9 in\cf2 \strokec2  os.listdir(path):\
                \cf9 \strokec9 if\cf2 \strokec2  f.endswith(\cf10 \strokec10 ".json"\cf2 \strokec2 ):\
                    \cf9 \strokec9 try\cf2 \strokec2 :\
                        \cf9 \strokec9 with\cf2 \strokec2  \cf12 \strokec12 open\cf2 \strokec2 (os.path.join(path, f), \cf10 \strokec10 'r'\cf2 \strokec2 , encoding=\cf10 \strokec10 'utf-8'\cf2 \strokec2 ) \cf9 \strokec9 as\cf2 \strokec2  jf:\
                            data = json.load(jf)\
                            \cf9 \strokec9 for\cf2 \strokec2  comp \cf9 \strokec9 in\cf2 \strokec2  data.get(\cf10 \strokec10 "competences"\cf2 \strokec2 , []):\
                                self.custom_domains[comp[\cf10 \strokec10 "name"\cf2 \strokec2 ]] = comp\
                    \cf9 \strokec9 except\cf2 \strokec2  Exception \cf9 \strokec9 as\cf2 \strokec2  e:\
                        print(\cf10 \strokec10 f"
\f8 \uc0\u9888 \u65039 
\f5  Fehler in \cf4 \strokec4 \{f\}\cf10 \strokec10 : \cf4 \strokec4 \{e\}\cf10 \strokec10 "\cf2 \strokec2 )\
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 _sync_legacy_sets\cf2 \strokec2 (self):\
        \cf9 \strokec9 for\cf2 \strokec2  name, comp \cf9 \strokec9 in\cf2 \strokec2  self.custom_domains.items():\
            lvl = comp.get(\cf10 \strokec10 "level"\cf2 \strokec2 )\
            \cf9 \strokec9 if\cf2 \strokec2  lvl == \cf14 \strokec14 4\cf2 \strokec2 : self._fachbuch_skills.add(name.lower())\
            \cf9 \strokec9 if\cf2 \strokec2  lvl == \cf14 \strokec14 5\cf2 \strokec2 : self._academia_skills.add(name.lower())\
\
    \cf3 \strokec3 # --- WICHTIG: Die Schnittstelle f\'fcr den Extractor ---\cf2 \strokec2 \
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 get_all_identifiable_labels\cf2 \strokec2 (self) -> List[str]:\
        \cf10 \strokec10 """Hier gab es den Absturz. Jetzt ist es ein Dict, also geht .keys() wieder!"""\cf2 \strokec2 \
        \cf9 \strokec9 return\cf2 \strokec2  \cf12 \strokec12 list\cf2 \strokec2 (self.esco_data.keys()) + \cf12 \strokec12 list\cf2 \strokec2 (self.custom_domains.keys())\
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 get_data_by_label\cf2 \strokec2 (self, label: \cf12 \strokec12 str\cf2 \strokec2 ) -> Optional[Dict[str, Any]]:\
        \cf10 \strokec10 """Fuzzy Suche im Dictionary."""\cf2 \strokec2 \
        choices = \cf12 \strokec12 list\cf2 \strokec2 (self.esco_data.keys())\
        \cf9 \strokec9 if\cf2 \strokec2  \cf9 \strokec9 not\cf2 \strokec2  choices: \cf9 \strokec9 return\cf2 \strokec2  \cf14 \strokec14 None\cf2 \strokec2 \
        match = process.extractOne(label.lower(), choices, scorer=fuzz.token_set_ratio)\
