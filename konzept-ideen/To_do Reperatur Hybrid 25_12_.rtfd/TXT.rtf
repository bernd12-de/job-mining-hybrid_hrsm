                    self.esco_data[label.lower()] = \{\
                        \cf10 \strokec10 "uri"\cf2 \strokec2 : item.get(\cf10 \strokec10 'uri'\cf2 \strokec2 ),\
                        \cf10 \strokec10 "is_digital"\cf2 \strokec2 : item.get(\cf10 \strokec10 'is_digital'\cf2 \strokec2 , \cf14 \strokec14 False\cf2 \strokec2 ),\
