\
        \cf3 \strokec3 # 2. Metadaten-Extraktion (NEU: Nutzt MetadataExtractor)\cf2 \strokec2 \
        metadata = self.meta_extractor.extract_all(raw_text, filename=source_name)\
\
        \cf3 \strokec3 # Text-Segmentierung (Intelligent)\cf2 \strokec2 \
        tasks_clean = metadata.get(\cf10 \strokec10 'tasks_clean'\cf2 \strokec2 , \cf10 \strokec10 ''\cf2 \strokec2 )\
