    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 load_all_data\cf2 \strokec2 (self):\
        \cf10 \strokec10 """Verbindet NEU (Client) mit ALT (Datenstruktur)."""\cf2 \strokec2 \
        print(\cf10 \strokec10 "
\f8 \uc0\u55357 \u56580 
\f5  Lade Wissensbasis..."\cf2 \strokec2 )\
\
        \cf3 \strokec3 # 1. Daten vom Client holen (Das ist eine LISTE)\cf2 \strokec2 \
