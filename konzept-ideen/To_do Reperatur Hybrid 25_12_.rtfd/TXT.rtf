            \cf9 \strokec9 return\cf2 \strokec2  self.esco_data[match[\cf14 \strokec14 0\cf2 \strokec2 ]]\
        \cf9 \strokec9 return\cf2 \strokec2  \cf14 \strokec14 None\cf2 \strokec2 \
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 get_level\cf2 \strokec2 (self, term: \cf12 \strokec12 str\cf2 \strokec2 ) -> int:\
