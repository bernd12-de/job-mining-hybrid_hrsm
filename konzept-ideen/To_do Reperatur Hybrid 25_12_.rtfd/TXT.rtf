\cf9 \strokec9 class\cf13 \strokec13  JobMiningWorkflowManager(IJobMiningWorkflowManager):\cf2 \strokec2 \
    \cf10 \strokec10 """\
    Die Schaltzentrale.\
    Verbindet API (Upload/Scraper) und Batch (Dateisystem) mit der Analyse-Logik.\
    """\cf2 \strokec2 \
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 __init__\cf2 \strokec2 (self,\
                 text_extractor: ITextExtractor,\
                 competence_extractor: ICompetenceExtractor,\
                 organization_service: OrganizationService,\
                 role_service: RoleService\
                 ):\
        self.text_extractor = text_extractor\
        self.competence_extractor = competence_extractor\
        self.organization_service = organization_service\
        self.role_service = role_service\
        self.meta_extractor = MetadataExtractor()\
\
    \cf3 \strokec3 # --- DAS HERZST\'dcCK (Private Methode) ---\cf2 \strokec2 \
    \cf3 \strokec3 # Hier l\'e4uft die eigentliche Logik ab. Alle anderen Methoden rufen DIESE auf.\cf2 \strokec2 \
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 _run_analysis_from_text\cf2 \strokec2 (self, raw_text: \cf12 \strokec12 str\cf2 \strokec2 , source_name: \cf12 \strokec12 str\cf2 \strokec2 ) -> AnalysisResultDTO:\
        \cf3 \strokec3 # 1. Hashing\cf2 \strokec2 \
        raw_text_hash = hashlib.sha256(raw_text.encode(\cf10 \strokec10 'utf-8'\cf2 \strokec2 )).hexdigest()\
\
        \cf3 \strokec3 # 2. Metadaten (Aufgaben vs. Profil trennen)\cf2 \strokec2 \
        metadata = self.meta_extractor.extract_all(raw_text, filename=source_name)\
\
        \cf3 \strokec3 # 3. Text-Vorbereitung (Segmentierung)\cf2 \strokec2 \
        tasks = metadata.get(\cf10 \strokec10 'tasks_clean'\cf2 \strokec2 , \cf10 \strokec10 ''\cf2 \strokec2 )\
        reqs = metadata.get(\cf10 \strokec10 'requirements_clean'\cf2 \strokec2 , \cf10 \strokec10 ''\cf2 \strokec2 )\
        clean_text_for_esco = (tasks + \cf10 \strokec10 " "\cf2 \strokec2  + reqs).strip()\
\
        \cf3 \strokec3 # Fallback: Wenn Segmentierung fehlschl\'e4gt (Text zu kurz), nimm alles\cf2 \strokec2 \
        \cf9 \strokec9 if\cf2 \strokec2  \cf12 \strokec12 len\cf2 \strokec2 (clean_text_for_esco) < \cf14 \strokec14 50\cf2 \strokec2 :\
            clean_text_for_esco = raw_text\
\
        \cf3 \strokec3 # 4. Kompetenzen finden (Hier arbeitet das reparierte Repository!)\cf2 \strokec2 \
        competences = self.competence_extractor.extract_competences(clean_text_for_esco)\
\
        \cf3 \strokec3 # 5. Kontext (Branche & Rolle)\cf2 \strokec2 \
        industry = self.organization_service.classify_industry(raw_text)\
        job_role = self.role_service.classify_role(\
            job_text=raw_text,\
            job_title=metadata.get(\cf10 \strokec10 'job_title'\cf2 \strokec2 , source_name)\
        )\
\
        iso_date, _, _ = parse_date(raw_text)\
\
        \cf3 \strokec3 # 6. Ergebnis bauen\cf2 \strokec2 \
        \cf9 \strokec9 return\cf2 \strokec2  AnalysisResultDTO(\
            title=metadata.get(\cf10 \strokec10 'job_title'\cf2 \strokec2 ) \cf9 \strokec9 or\cf2 \strokec2  source_name,\
            job_role=job_role,\
            region=metadata.get(\cf10 \strokec10 'location'\cf2 \strokec2 ) \cf9 \strokec9 or\cf2 \strokec2  \cf10 \strokec10 "Unbekannt"\cf2 \strokec2 ,\
            industry=industry,\
            posting_date=iso_date \cf9 \strokec9 or\cf2 \strokec2  \cf10 \strokec10 "2024-12-01"\cf2 \strokec2 ,\
            raw_text_hash=raw_text_hash,\
            raw_text=raw_text,\
            is_segmented=metadata.get(\cf10 \strokec10 'is_segmented'\cf2 \strokec2 , \cf14 \strokec14 False\cf2 \strokec2 ),\
            competences=competences\
        )\
\
    \cf3 \strokec3 # --- T\'dcR 1: Datei-Upload (PDF/DOCX) ---\cf2 \strokec2 \
    \cf3 \strokec3 # Wird aufgerufen via POST /api/v1/jobs/upload (Swagger)\cf2 \strokec2 \
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 run_full_analysis\cf2 \strokec2 (self, file_stream: BinaryIO, filename: \cf12 \strokec12 str\cf2 \strokec2 ) -> AnalysisResultDTO:\
        \cf10 \strokec10 """Extrahiert Text aus Datei und startet Analyse."""\cf2 \strokec2 \
        raw_text = self.text_extractor.extract_text(file_stream, filename)\
        cleaned_raw_text = raw_text.replace(\cf10 \strokec10 '\\x00'\cf2 \strokec2 , \cf10 \strokec10 ''\cf2 \strokec2 )\
        \cf9 \strokec9 return\cf2 \strokec2  self._run_analysis_from_text(cleaned_raw_text, filename)\
\
    \cf3 \strokec3 # --- T\'dcR 2: Scraping / Reiner Text ---\cf2 \strokec2 \
    \cf3 \strokec3 # Wird aufgerufen via POST /analyse/text\cf2 \strokec2 \
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 run_analysis_from_scraped_text\cf2 \strokec2 (self, cleaned_text: \cf12 \strokec12 str\cf2 \strokec2 , source_name: \cf12 \strokec12 str\cf2 \strokec2 ) -> AnalysisResultDTO:\
        \cf10 \strokec10 """Nimmt fertigen Text (z.B. von Webseite) und startet Analyse."""\cf2 \strokec2 \
        \cf9 \strokec9 return\cf2 \strokec2  self._run_analysis_from_text(cleaned_text, source_name)\
\
    \cf3 \strokec3 # --- T\'dcR 3: Batch-Verarbeitung (Lokaler Ordner) ---\cf2 \strokec2 \
    \cf3 \strokec3 # Wird aufgerufen via GET /analyse/batch\cf2 \strokec2 \
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 process_local_directory\cf2 \strokec2 (self) -> List[AnalysisResultDTO]:\
        \cf10 \strokec10 """\
        Liest ALLE .txt Dateien aus data/job_ads und analysiert sie.\
        Wichtig f\'fcr Massentests.\
        """\cf2 \strokec2 \
        results = []\
        job_dir = Path(\cf10 \strokec10 "data/job_ads"\cf2 \strokec2 )\
        \
        \cf9 \strokec9 if\cf2 \strokec2  \cf9 \strokec9 not\cf2 \strokec2  job_dir.exists():\
            print(\cf10 \strokec10 f"
\f8 \uc0\u9888 \u65039 
\f5  Batch-Ordner fehlt: \cf4 \strokec4 \{job_dir.absolute()\}\cf10 \strokec10 "\cf2 \strokec2 )\
            \cf9 \strokec9 return\cf2 \strokec2  []\
\
        files = \cf12 \strokec12 list\cf2 \strokec2 (job_dir.glob(\cf10 \strokec10 "*.txt"\cf2 \strokec2 ))\
        print(\cf10 \strokec10 f"
\f8 \uc0\u55357 \u56960 
\f5  Starte Batch f\'fcr \cf4 \strokec4 \{\cf12 \strokec12 len\cf4 \strokec4 (files)\}\cf10 \strokec10  Dateien..."\cf2 \strokec2 )\
\
        \cf9 \strokec9 for\cf2 \strokec2  file_path \cf9 \strokec9 in\cf2 \strokec2  files:\
            \cf9 \strokec9 try\cf2 \strokec2 :\
                \cf9 \strokec9 with\cf2 \strokec2  \cf12 \strokec12 open\cf2 \strokec2 (file_path, \cf10 \strokec10 "r"\cf2 \strokec2 , encoding=\cf10 \strokec10 "utf-8"\cf2 \strokec2 ) \cf9 \strokec9 as\cf2 \strokec2  f:\
                    content = f.read()\
                    \cf3 \strokec3 # Ruft die gleiche Logik auf wie der Upload!\cf2 \strokec2 \
                    analysis = self._run_analysis_from_text(content, source_name=file_path.name)\
                    results.append(analysis)\
            \cf9 \strokec9 except\cf2 \strokec2  Exception \cf9 \strokec9 as\cf2 \strokec2  e:\
                print(\cf10 \strokec10 f"
\f8 \uc0\u10060 
\f5  Fehler bei Batch-Datei \cf4 \strokec4 \{file_path.name\}\cf10 \strokec10 : \cf4 \strokec4 \{e\}\cf10 \strokec10 "\cf2 \strokec2 )\
        \
        \cf9 \strokec9 return\cf2 \strokec2  results\
