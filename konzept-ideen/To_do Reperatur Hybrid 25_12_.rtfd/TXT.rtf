            print(\cf10 \strokec10 f"
\f8 \uc0\u9989 
\f5  \cf4 \strokec4 \{count\}\cf10 \strokec10  Skills erfolgreich in Such-Index (esco_data) geladen."\cf2 \strokec2 )\
        \cf9 \strokec9 else\cf2 \strokec2 :\
