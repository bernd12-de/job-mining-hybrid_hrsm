        \cf9 \strokec9 return\cf2 \strokec2  self.esco_data.get(term.lower(), \{\}).get(\cf10 \strokec10 'is_digital'\cf2 \strokec2 , \cf14 \strokec14 False\cf2 \strokec2 )\
