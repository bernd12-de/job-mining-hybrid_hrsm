\cf9 \strokec9 class\cf13 \strokec13  JobMiningWorkflowManager(IJobMiningWorkflowManager):\cf2 \strokec2 \
    \cf10 \strokec10 """Orchestrierung der Analyse-Pipeline (CRISP-DM Zyklus)."""\cf2 \strokec2 \
\
    \cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 __init__\cf2 \strokec2 (self,\
                 text_extractor: ITextExtractor,\
