\cf9 \strokec9 def\cf2 \strokec2  \cf13 \strokec13 scrape_and_analyze_url\cf2 \strokec2 (url_input: URLInput, manager: IJobMiningWorkflowManager = Depends(\cf9 \strokec9 lambda\cf2 \strokec2 : \cf14 \strokec14 None\cf2 \strokec2 )):\
    url = url_input.url\
    raw_text = \cf10 \strokec10 ""\cf2 \strokec2 \
\
    \cf3 \strokec3 # 1. ENTWEDER: JavaScript Rendering (Playwright)\cf2 \strokec2 \
    \cf9 \strokec9 if\cf2 \strokec2  url_input.render_js:\
        print(\cf10 \strokec10 f"-> Starte JS-Scraping f\'fcr URL: \cf4 \strokec4 \{url\}\cf10 \strokec10 "\cf2 \strokec2 )\
        \cf9 \strokec9 try\cf2 \strokec2 :\
            raw_text = scrape_with_rendering(url) \
        \cf9 \strokec9 except\cf2 \strokec2  Exception \cf9 \strokec9 as\cf2 \strokec2  e:\
            \cf3 \strokec3 # Fallback oder harter Fehler - je nach Wunsch. Hier Fehler:\cf2 \strokec2 \
            \cf9 \strokec9 raise\cf2 \strokec2  HTTPException(status_code=\cf14 \strokec14 500\cf2 \strokec2 , detail=\cf10 \strokec10 f"JS-Rendering Fehler: \cf4 \strokec4 \{\cf12 \strokec12 str\cf4 \strokec4 (e)\}\cf10 \strokec10 "\cf2 \strokec2 )\
\
    \cf3 \strokec3 # 2. ODER: Statischer Request (Requests)\cf2 \strokec2 \
    \cf9 \strokec9 else\cf2 \strokec2 :\
        print(\cf10 \strokec10 f"-> Starte statisches Scraping f\'fcr URL: \cf4 \strokec4 \{url\}\cf10 \strokec10 "\cf2 \strokec2 )\
        headers = \{\cf10 \strokec10 'User-Agent'\cf2 \strokec2 : \cf10 \strokec10 'Mozilla/5.0'\cf2 \strokec2 \}\
        \cf9 \strokec9 try\cf2 \strokec2 :\
            response = requests.get(url, headers=headers, timeout=\cf14 \strokec14 15\cf2 \strokec2 )\
            response.raise_for_status()\
            soup = BeautifulSoup(response.content, \cf10 \strokec10 'html.parser'\cf2 \strokec2 )\
            raw_text = _extract_job_content(soup)\
        \cf9 \strokec9 except\cf2 \strokec2  requests.HTTPError \cf9 \strokec9 as\cf2 \strokec2  e:\
            \cf9 \strokec9 raise\cf2 \strokec2  HTTPException(status_code=e.response.status_code, detail=\cf10 \strokec10 f"HTTP-Fehler: \cf4 \strokec4 \{e\}\cf10 \strokec10 "\cf2 \strokec2 )\
        \cf9 \strokec9 except\cf2 \strokec2  Exception \cf9 \strokec9 as\cf2 \strokec2  e:\
            \cf9 \strokec9 raise\cf2 \strokec2  HTTPException(status_code=\cf14 \strokec14 500\cf2 \strokec2 , detail=\cf10 \strokec10 f"Scraping-Fehler: \cf4 \strokec4 \{\cf12 \strokec12 str\cf4 \strokec4 (e)\}\cf10 \strokec10 "\cf2 \strokec2 )\
\
    \cf3 \strokec3 # 3. Validierung & Analyse (Gilt f\'fcr BEIDE Wege)\cf2 \strokec2 \
    \cf9 \strokec9 if\cf2 \strokec2  \cf9 \strokec9 not\cf2 \strokec2  raw_text \cf9 \strokec9 or\cf2 \strokec2  \cf12 \strokec12 len\cf2 \strokec2 (raw_text) < \cf14 \strokec14 100\cf2 \strokec2 :\
        \cf9 \strokec9 raise\cf2 \strokec2  HTTPException(\
            status_code=\cf14 \strokec14 400\cf2 \strokec2 , \
            detail=\cf10 \strokec10 "Scraping erfolgreich, aber zu wenig Text gefunden. Versuche 'render_js=True'."\cf2 \strokec2 \
        )\
\
    cleaned_raw_text = raw_text.replace(\cf10 \strokec10 '\\x00'\cf2 \strokec2 , \cf10 \strokec10 ''\cf2 \strokec2 )\
    \
    \cf3 \strokec3 # Aufruf der Analyse-Logik\cf2 \strokec2 \
    \cf9 \strokec9 try\cf2 \strokec2 :\
        analysis_result = manager.run_analysis_from_scraped_text(cleaned_raw_text, url)\
        \cf9 \strokec9 return\cf2 \strokec2  analysis_result\
    \cf9 \strokec9 except\cf2 \strokec2  Exception \cf9 \strokec9 as\cf2 \strokec2  e:\
        \cf9 \strokec9 raise\cf2 \strokec2  HTTPException(status_code=\cf14 \strokec14 500\cf2 \strokec2 , detail=\cf10 \strokec10 f"Analysefehler im Workflow Manager: \cf4 \strokec4 \{\cf12 \strokec12 str\cf4 \strokec4 (e)\}\cf10 \strokec10 "\cf2 \strokec2 )\
