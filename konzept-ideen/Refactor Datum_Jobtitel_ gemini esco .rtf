\f5\fs26 import re\
\
class RoleService:\
    def __init__(self):\
        # Deine Masterarbeits-Kategorien\
        self.ROLE_MAPPINGS = \{\
            "Product Owner": [r"product owner", r"po", r"product manager", r"produktmanager"],\
            "UX/UI Designer": [r"ux", r"ui", r"user experience", r"interaction design", r"usability"],\
            "Software Engineer": [r"developer", r"entwickler", r"engineer", r"programmer", r"java", r"backend"],\
            "Data Scientist": [r"data", r"scientist", r"analyst", r"machine learning", r"ai"],\
            "Agile Coach": [r"scrum master", r"agile coach", r"kanban"],\
            "Management": [r"director", r"head of", r"leiter", r"vp", r"manager"]\
        \}\
\
    def predict_role(self, job_title: str, tasks_text: str) -> str:\
        # 1. Priorit\'e4t: Titel checken (Der "TitleExtractor" hat vorgearbeitet)\
        title_lower = job_title.lower()\
        for role, patterns in self.ROLE_MAPPINGS.items():\
            if any(re.search(p, title_lower) for p in patterns):\
                return role\
        \
        # 2. Priorit\'e4t: Text checken (Falls Titel kryptisch ist)\
        # Z\'e4hle Keywords im Aufgabentext\
        scores = \{role: 0 for role in self.ROLE_MAPPINGS\}\
        for role, patterns in self.ROLE_MAPPINGS.items():\
            for p in patterns:\
                scores[role] += len(re.findall(p, tasks_text.lower()))\
        \
        # Gewinner ermitteln\
        best_role = max(scores, key=scores.get)\
        if scores[best_role] > 0:\
            return best_role\
            \
        return "Sonstige"\
