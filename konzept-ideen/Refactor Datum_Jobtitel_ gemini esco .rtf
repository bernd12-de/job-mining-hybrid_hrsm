\f5\fs26 import spacy\
import re\
from typing import List, Optional\
from app.interfaces.interfaces import ICompetenceExtractor\
from app.domain.models import CompetenceDTO\
\
class CompetenceExtractor(ICompetenceExtractor):\
    def __init__(self, spacy_ext, fuzzy_ext, discovery_ext, repository):\
        self.spacy_ext = spacy_ext\
        self.fuzzy_ext = fuzzy_ext\
        self.discovery_ext = discovery_ext\
        self.repository = repository\
        \
        # Laden des NLP Modells f\'fcr Satz-Analyse\
        try:\
            self.nlp = spacy.load("de_core_news_md")\
        except:\
            self.nlp = spacy.load("de_core_news_sm")\
\
    def extract_competences(self, text: str, role: Optional[str] = None) -> List[CompetenceDTO]:\
        """\
        F\'fchrt die Extraktion auf dem BEREINIGTEN Text durch.\
        Nutzt die Rolle, um Fachbuch-Wissen zu kontextualisieren.\
        """\
        \
        # 1. NLP Parsing (Satzstruktur verstehen: Subjekt -> Pr\'e4dikat -> Objekt)\
        # Das verhindert, dass wir isolierte W\'f6rter ohne Sinn finden.\
        doc = self.nlp(text)\
\
        # 2. Spezialisten-Module abfragen\
        # SpaCy: Findet Phrasen basierend auf ESCO\
        results = self.spacy_ext.extract(doc, role) \
        \
        # Fuzzy: Findet Schreibfehler / Varianten\
        results += self.fuzzy_ext.extract_competences(text)\
        \
        # Discovery: Findet unbekannte Gro\'dfgeschriebene Begriffe (Ebene 1)\
        # Nur wenn sie NICHT schon durch SpaCy/Fuzzy gefunden wurden\
        results += self.discovery_ext.extract(doc)\
\
        # 3. Konsolidierung & 7-Ebenen-Logik\
        return self._finalize_and_level(results, role)\
\
    def _finalize_and_level(self, dtos: List[CompetenceDTO], role: str) -> List[CompetenceDTO]:\
        seen = set()\
        final_list = []\
        \
        for dto in dtos:\
            # Deduplizierung basierend auf URI (oder Begriff, wenn Discovery)\
            unique_key = dto.esco_uri if dto.esco_uri else dto.original_term.lower()\
            \
            if unique_key not in seen:\
                dto.role_context = role\
                \
                # --- DIE HAKEN-LOGIK (Ebene 1 bis 5) ---\
                term = dto.original_term\
                \
                # Haken 1: ESCO (Ebene 2)\
                # Pr\'fcft gegen die 31.655 Labels im Repository\
                is_esco = self.repository.is_esco(term)\
                \
                # Haken 2: Digital (Ebene 3)\
                # Pr\'fcft gegen digitalSkillsCollection.csv\
                dto.is_digital = self.repository.is_digital_skill(term)\
                \
                # Haken 3: Academic / Fachbuch (Ebene 4 & 5)\
                # Pr\'fcft gegen agile_methods.json, borchert.json etc.\
                is_academic = self.repository.check_academic_validity(term)\
                \
                # LEVEL ZUWEISUNG (Die Priorisierung)\
                if is_academic and is_esco:\
                    dto.level = 4  # Gold-Standard: ESCO + Wissenschaftlich belegt\
                    dto.source_domain = "Fachbuch & ESCO"\
                elif is_academic:\
                    dto.level = 4  # Wissenschaftliche Theorie (evtl. neuer als ESCO)\
                    dto.source_domain = "Fachbuch/Modulhandbuch"\
                elif is_esco:\
                    dto.level = 2  # Industriestandard\
                    dto.source_domain = "ESCO v1.2"\
                else:\
                    dto.level = 1  # Markt-Innovation (Discovery)\
                    dto.source_domain = "Stellenanzeige (Emergent)"\
                    dto.is_discovery = True\
\
                final_list.append(dto)\
                seen.add(unique_key)\
                \
        return final_list\
