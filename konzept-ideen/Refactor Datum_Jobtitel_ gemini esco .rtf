\cf0 Python\
\
\pard\pardeftab720\partightenfactor0

\f5\fs26 \cf0 import io\
import pypdf\
import zipfile\
import re\
from typing import BinaryIO\
\
class TextExtractor:\
    """\
    Die Weiche f\'fcr verschiedene Dateiformate.\
    Unterst\'fctzt: PDF, DOCX, TXT.\
    """\
    \
    def extract_text(self, file_stream: BinaryIO, filename: str) -> str:\
        filename = filename.lower()\
        \
        # 1. PDF\
        if filename.endswith(".pdf"):\
            return self._extract_from_pdf(file_stream)\
            \
        # 2. WORD (DOCX)\
        elif filename.endswith(".docx"):\
            return self._extract_from_docx(file_stream)\
            \
        # 3. TEXT\
        elif filename.endswith(".txt"):\
            return file_stream.read().decode('utf-8', errors='ignore')\
            \
        else:\
            # Fallback oder Fehler, je nach Wunsch\
            # Wir geben leeren Text zur\'fcck, damit der Batch nicht crasht,\
            # aber loggen sollten wir es im Manager.\
            raise ValueError(f"Nicht unterst\'fctztes Dateiformat: \{filename\}")\
\
    def _extract_from_pdf(self, stream) -> str:\
        text = ""\
        try:\
            reader = pypdf.PdfReader(stream)\
            for page in reader.pages:\
                page_text = page.extract_text()\
                if page_text:\
                    text += page_text + "\\n"\
        except Exception as e:\
            print(f"PDF Error: \{e\}")\
            # Manche PDFs sind korrupt, wir versuchen zu retten was geht\
            return ""\
        return text\
\
    def _extract_from_docx(self, stream) -> str:\
        """\
        Liest DOCX ohne riesige Abh\'e4ngigkeiten wie python-docx,\
        indem es direkt das XML im ZIP-Container parst.\
        Das ist schneller und robuster f\'fcr reine Textextraktion.\
        """\
        text = ""\
        try:\
            with zipfile.ZipFile(stream) as z:\
                # DOCX ist ein ZIP. Der Text steckt in word/document.xml\
                with z.open("word/document.xml") as f:\
                    xml_content = f.read().decode('utf-8')\
                    # Entferne alle XML-Tags (<w:p>, <w:t> etc.) und ersetze sie durch Leerzeichen\
                    text = re.sub(r'<[^>]+>', ' ', xml_content)\
                    # Bereinige Whitespace\
                    text = re.sub(r'\\s+', ' ', text).strip()\
        except Exception as e:\
            print(f"DOCX Error: \{e\}")\
            return ""\
        return text\
\pard\pardeftab720\sa280\partightenfactor0

