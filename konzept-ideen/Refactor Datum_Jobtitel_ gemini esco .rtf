\f1\b0 \cf0 \strokec2 Und hier ist die Logik, die den 
\f2\b Dom\'e4nen-Check
\f1\b0  basierend auf der Rolle macht (Schritt 3 & 4 der Erkl\'e4rung).\
\pard\pardeftab720\partightenfactor0
\cf0 Python\
\

\f5\fs26 class CompetenceExtractor:\
    def __init__(self, spacy_ext, fuzzy_ext, discovery_ext, repository):\
        self.spacy_ext = spacy_ext\
        self.fuzzy_ext = fuzzy_ext\
        self.discovery_ext = discovery_ext\
        self.repository = repository # HybridRepo mit Fachb\'fcchern\
\
    def extract_competences(self, text: str, role_context: str) -> list:\
        # 1. Lade die passende Fachbuch-Dom\'e4ne f\'fcr die Rolle!\
        # Wenn Rolle == "Product Owner", priorisiere "agile_methods.json"\
        self.repository.set_active_context(role_context) \
\
        # 2. NLP Analyse (Satz-Struktur)\
        doc = self.nlp(text)\
        \
        # 3. Spezialisten suchen lassen\
        # SpaCy schaut auf Grammatik (Nomen + Verben)\
        results = self.spacy_ext.extract(doc) \
        \
        # Discovery schaut auf unbekannte Gro\'dfgeschriebene W\'f6rter (Ebene 1)\
        results += self.discovery_ext.extract(doc)\
\
        # 4. Validierung & Level-Vergabe (Die 7 Ebenen)\
        final_competences = []\
        for comp in results:\
            # Check: ESCO? (Ebene 2)\
            is_esco = self.repository.is_esco(comp.original_term)\
            \
            # Check: Fachbuch? (Ebene 4) - Aber nur im passenden Kontext!\
            # Ein "Backlog" ist nur im "Agile"-Kontext Ebene 4, sonst vielleicht nur Ebene 1.\
            is_academic = self.repository.is_in_domain(comp.original_term, role_context)\
            \
            # Level Logik\
            if is_academic and is_esco:\
                comp.level = 4 # Gold-Standard (Validiert)\
            elif is_esco:\
                comp.level = 2 # Standard\
            else:\
                comp.level = 1 # Markttrend (Discovery)\
\
            comp.role_context = role_context\
            final_competences.append(comp)\
\
        return final_competences\
