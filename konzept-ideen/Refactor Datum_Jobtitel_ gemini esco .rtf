\pard\pardeftab720\partightenfactor0
\cf0 Python\
\

\f5\fs26 import re\
import os\
from datetime import datetime\
\
class MetadataExtractor:\
    \
    def extract_posting_date(self, text: str, filename: str) -> str:\
        """\
        Ermittelt das Datum mit strikter Hierarchie, um Druckdaten (2025)\
        bei alten Anzeigen (2011) zu ignorieren.\
        """\
\
        # STUFE 1: Dateiname (Der "User Override")\
        # Wenn die Datei "Ausschreibung2011.pdf" hei\'dft, nimm 2011-01-01 (oder genaueres Datum falls m\'f6glich)\
        # Suche nach Jahreszahl YYYY im Dateinamen\
        year_match = re.search(r'(20\\d\{2\})', filename)\
        if year_match:\
            year = year_match.group(1)\
            # Optional: Versuche ein volles Datum im Dateinamen zu finden (2011-11-18)\
            full_date_match = re.search(r'(\\d\{4\}-\\d\{2\}-\\d\{2\})', filename)\
            if full_date_match:\
                return full_date_match.group(1)\
            \
            # Sonst nimm den 1. Januar des Jahres als Sch\'e4tzung (besser als das heutige Druckdatum!)\
            return f"\{year\}-01-01"\
\
        # STUFE 2: Kontext-Suche ("Eingestellt am...")\
        # Ignoriert nackte Daten im Header, sucht nach Labels.\
        keyword_patterns = [\
            r'(?:Eingestellt am|Ver\'f6ffentlicht|Datum|Date|Posted):\\s*(\\d\{1,2\}\\.\\d\{1,2\}\\.\\d\{2,4\})',\
            r'(?:Eingestellt am|Ver\'f6ffentlicht|Datum|Date|Posted):\\s*(\\d\{4\}-\\d\{2\}-\\d\{2\})'\
        ]\
        \
        for pattern in keyword_patterns:\
            match = re.search(pattern, text, re.IGNORECASE)\
            if match:\
                return self._normalize_date(match.group(1))\
\
        # STUFE 3: Header-Ausschluss (Heuristik)\
        # Suche nach Daten im Text, aber \'fcberspringe die ersten 200 Zeichen (Header),\
        # falls dort das Druckdatum steht.\
        body_text = text[200:] if len(text) > 200 else text\
        \
        date_patterns = [r'(\\d\{1,2\}\\.\\d\{1,2\}\\.\\d\{4\})', r'(\\d\{4\}-\\d\{2\}-\\d\{2\})']\
        for pattern in date_patterns:\
            match = re.search(pattern, body_text)\
            if match:\
                return self._normalize_date(match.group(1))\
\
        # STUFE 4: Notfall (Wenn alles fehlschl\'e4gt, nimm Metadaten oder Default)\
        # Warnung: Das k\'f6nnte das Upload-Datum sein!\
        return "2024-01-01" \
\
    def _normalize_date(self, date_str):\
        # Hilfsfunktion um z.B. 1.1.11 in 2011-01-01 zu wandeln\
        # ... (Implementierung wie gehabt)\
        return date_str\
