\f5\fs26 import hashlib\
from app.interfaces.interfaces import IJobMiningWorkflowManager\
from app.domain.models import AnalysisResultDTO\
\
class JobMiningWorkflowManager(IJobMiningWorkflowManager):\
    def __init__(self, text_extractor, competence_extractor, organization_service, role_service):\
        self.text_extractor = text_extractor\
        self.competence_extractor = competence_extractor # Der "Chef-Analyst"\
        self.organization_service = organization_service\
        self.role_service = role_service\
\
    def run_full_analysis(self, file_stream, filename) -> AnalysisResultDTO:\
        # 1. Roh-Text extrahieren (PDF/DOCX)\
        raw_text = self.text_extractor.extract_text(file_stream, filename)\
        \
        # 2. Metadaten & Sektionen trennen (Der Sektions-Filter)\
        # Wir holen uns gezielt 'tasks' und 'requirements'\
        meta = self.meta_extractor.extract_all(raw_text, filename)\
        relevant_text = meta['tasks_clean'] + " " + meta['requirements_clean']\
        \
        # Fallback: Wenn Segmentierung scheitert (bei alten PDFs), nimm alles\
        if len(relevant_text) < 50:\
            relevant_text = raw_text\
\
        # 3. Rolle bestimmen (Die Rollen-Brille)\
        # "Ist das ein UX-Job oder ein Java-Job?"\
        detected_role = self.role_service.predict_role(meta['job_title'], relevant_text)\
        \
        # 4. Branche bestimmen (F\'fcr Ebene 6 Analyse)\
        industry = self.organization_service.predict_industry(meta['organization'])\
\
        # 5. Kompetenz-Extraktion MIT KONTEXT\
        # Wir \'fcbergeben jetzt die Rolle und den relevanten Text!\
        competences = self.competence_extractor.extract_competences(\
            text=relevant_text, \
            role_context=detected_role # <--- Das ist der Schl\'fcssel!\
        )\
\
        return AnalysisResultDTO(\
            title=meta['job_title'],\
            job_role=detected_role,\
            industry=industry,\
            posting_date=meta['posting_date'],\
            raw_text=raw_text,\
            is_segmented=meta['is_segmented'],\
            competences=competences\
        )\
