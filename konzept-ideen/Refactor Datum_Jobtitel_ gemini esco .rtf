\f5\fs26 import hashlib\
from typing import BinaryIO, List\
from pathlib import Path\
\
# Interfaces & DTOs\
from app.interfaces.interfaces import IJobMiningWorkflowManager, ITextExtractor, ICompetenceExtractor\
from app.domain.models import AnalysisResultDTO\
\
# Services & Extractors\
from app.infrastructure.extractor.metadata_extractor import MetadataExtractor\
from app.application.services.organization_service import OrganizationService\
from app.application.services.role_service import RoleService\
\
class JobMiningWorkflowManager(IJobMiningWorkflowManager):\
    """\
    Orchestrierung der Analyse-Pipeline (Wiederhergestellte V13.3 Logik).\
    Fokus: Kontext-basierte Extraktion statt blindem Keyword-Matching.\
    """\
\
    def __init__(self,\
                 text_extractor: ITextExtractor,\
                 competence_extractor: ICompetenceExtractor,\
                 organization_service: OrganizationService,\
                 role_service: RoleService\
                 ):\
        self.text_extractor = text_extractor\
        self.competence_extractor = competence_extractor\
        self.organization_service = organization_service\
        self.role_service = role_service\
        self.meta_extractor = MetadataExtractor()\
\
    def run_full_analysis(self, file_stream: BinaryIO, filename: str) -> AnalysisResultDTO:\
        # 1. Roh-Text extrahieren\
        raw_text = self.text_extractor.extract_text(file_stream, filename)\
        \
        return self._execute_pipeline(raw_text, filename)\
\
    def run_analysis_from_scraped_text(self, cleaned_text: str, source_name: str) -> AnalysisResultDTO:\
        # F\'fcr Web-Scraping (URL)\
        return self._execute_pipeline(cleaned_text, source_name)\
\
    def _execute_pipeline(self, raw_text: str, source_name: str) -> AnalysisResultDTO:\
        """Kern-Logik: Filterung -> Rollenerkennung -> Kontext-Extraktion"""\
        \
        # 1. Hashing f\'fcr Idempotenz (verhindert doppelte DB-Eintr\'e4ge)\
        raw_text_hash = hashlib.sha256(raw_text.encode('utf-8')).hexdigest()\
\
        # 2. Metadaten & Sektionen extrahieren\
        # Hier passiert die Magie: Wir trennen 'Aufgaben' vom Rest!\
        meta = self.meta_extractor.extract_all(raw_text, source_name, full_path=source_name)\
        \
        # Entscheidung: Welchen Text analysieren wir?\
        if meta.get('is_segmented') and meta.get('processing_text'):\
            # PERFEKT: Wir nutzen nur Aufgaben & Anforderungen (Sektions-Filter)\
            analysis_text = meta['processing_text']\
            # print(f"   \uc0\u9986 \u65039  Nutze segmentierten Text (\{len(analysis_text)\} Zeichen) f\'fcr \{source_name\}")\
        else:\
            # FALLBACK: Wenn PDF keine Struktur hat, m\'fcssen wir alles nehmen\
            analysis_text = raw_text\
            # print(f"   \uc0\u9888 \u65039  Keine Sektionen erkannt. Nutze Volltext f\'fcr \{source_name\}")\
\
        # 3. Kontext bestimmen (Rolle & Branche)\
        # Die Rolle hilft uns sp\'e4ter, die richtigen Fachbuch-Begriffe zu priorisieren\
        detected_role = self.role_service.predict_role(meta['job_title'], analysis_text)\
        industry = self.organization_service.predict_industry(meta.get('organization', ''))\
\
        # 4. Kompetenz-Extraktion MIT KONTEXT\
        # Wir \'fcbergeben die Rolle, damit der Extractor wei\'df: "Aha, Product Owner -> Agile Domain wichtig"\
        competences = self.competence_extractor.extract_competences(\
            text=analysis_text, \
            role=detected_role \
        )\
\
        # 5. Ergebnis zusammenbauen\
        return AnalysisResultDTO(\
            title=meta['job_title'],\
            job_role=detected_role,\
            industry=industry,\
            region=meta.get('location', 'Unbekannt'),\
            posting_date=str(meta.get('posting_date') or '2024-01-01'),\
            raw_text_hash=raw_text_hash,\
            raw_text=raw_text, # Wir speichern das Original, analysieren aber das Segment\
            is_segmented=meta.get('is_segmented', False),\
            competences=competences\
        )\
